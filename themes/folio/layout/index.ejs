                                                            } else if (l.startsWith('### ')) {
                                                                skipSection = false;
                                                                currentSection = { title: l.replace('### ', ''), items: [], groups: [], text: '' };
                                                                coopSections.push(currentSection);
                                                                currentGroup = null;
                                                            } else if (skipSection) {
                                                                return;
                                                            } else if (l.startsWith('#### ') && currentSection) {
                                                                currentGroup = { title: l.replace('#### ', ''), listItems: [] };
                                                                currentSection.groups.push(currentGroup);
                                                            } else if (l.startsWith('- ') && currentGroup) {
                                                                currentGroup.listItems.push(l.replace('- ', ''));
                                                            } else if (l.startsWith('**') && currentSection) {
                                                                const titleMatch = l.match(/^\*\*(.+?)\*\*(?:\s*—\s*\*(.+?)\*)?$/);
                                                                if (titleMatch) {
                                                                    currentSection.items.push({
                                                                        title: titleMatch[1],
                                                                        price: titleMatch[2] || '',
                                                                        desc: ''
                                                                    });
                                                                }
                                                            } else if (currentSection && currentSection.items.length > 0) {
                                                                const lastItem = currentSection.items[currentSection.items.length - 1];
                                                                lastItem.desc += (lastItem.desc ? ' ' : '') + l;
                                                            } else if (currentSection && currentSection.items.length === 0 && !currentGroup) {
                                                                currentSection.text += (currentSection.text ? ' ' : '') + l;
                                                            } else if (!currentSection) {
                                                                coopIntro.push(l);
                                                            }
                                                        });
                                                    %>
                                                    <div class="collab-section" id="collab-section">
                                                        <div class="collab-inner">
                                                            <div class="collab-header">
                                                                <h3 class="collab-heading"><%= coopTitle %></h3>
                                                                <a href="#" class="collab-close" id="collab-close">
                                                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                                                                        <line x1="1" y1="1" x2="13" y2="13"></line>
                                                                        <line x1="13" y1="1" x2="1" y2="13"></line>
                                                                    </svg>
                                                                    Close
                                                                </a>
                                                            </div>
                                                            <% if (coopIntro.length) { %>
                                                                <p class="collab-text"><%= coopIntro.join(' ') %></p>
                                                            <% } %>
                                                            <% coopSections.forEach(section => { %>
                                                                <h4 class="collab-subheading"><%= section.title %></h4>
                                                                <% if (section.text) { %>
                                                                    <p class="collab-text"><%= section.text %></p>
                                                                <% } %>
                                                                <% if (section.items.length > 0) { %>
                                                                    <div class="collab-cards">
                                                                        <% section.items.forEach(item => { %>
                                                                            <div class="collab-card">
                                                                                <strong><%= item.title %></strong>
                                                                                <% if (item.price) { %>
                                                                                    <span class="collab-price"><%= item.price %></span>
                                                                                <% } %>
                                                                                <span><%= item.desc %></span>
                                                                            </div>
                                                                        <% }); %>
                                                                    </div>
                                                                <% } %>
                                                                <% if (section.groups.length > 0) { %>
                                                                    <div class="collab-groups">
                                                                        <% section.groups.forEach(group => { %>
                                                                            <div class="collab-group">
                                                                                <h5 class="collab-group-title"><%= group.title %></h5>
                                                                                <ul class="collab-checklist">
                                                                                    <% group.listItems.forEach(item => { %>
                                                                                        <li class="collab-check-item">
                                                                                            <span class="collab-dot"></span>
                                                                                            <%= item %>
                                                                                        </li>
                                                                                    <% }); %>
                                                                                </ul>
                                                                            </div>
                                                                        <% }); %>
                                                                    </div>
                                                                <% } %>
                                                            <% }); %>
                                                        </div>
                                                    </div>
                                                    <div class="connect-footer-bottom">
                                                        <a href="mailto:<%= theme.connect.email %>"
                                                            class="connect-footer-email copy-email-btn">
                                                            <%= theme.connect.email %>
                                                        </a>
                                                        <div class="connect-footer-socials">
                                                            <a href="<%- url_for('images/Michal%20Sambora%20Resume.pdf') %>"
                                                                target="_blank" class="connect-footer-resume" style="display: inline-flex; align-items: center; gap: 5px;">
                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                    stroke-width="2" stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                                    style="width: 14px; height: 14px;">
                                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                                    <polyline points="14 2 14 8 20 8"></polyline>
                                                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                                                    <polyline points="10 9 9 9 8 9"></polyline>
                                                                </svg> Resume</a>
                                                            <% if (theme.social?.twitter) { %><a
                                                                    href="<%= theme.social.twitter %>"
                                                                    target="_blank">Twitter</a>
                                                                <% } %>
                                                                    <% if (theme.social?.linkedin) { %><a
                                                                            href="<%= theme.social.linkedin %>"
                                                                            target="_blank">Linkedin</a>
                                                                        <% } %>
                                                                            <% if (theme.social?.dribbble) { %><a
                                                                                    href="<%= theme.social.dribbble %>"
                                                                                    target="_blank">Dribbble</a>
                                                                                <% } %>
                                                                                    <% if (theme.social?.behance) { %><a
                                                                                            href="<%= theme.social.behance %>"
                                                                                            target="_blank">Behance</a>
                                                                                        <% } %>
                                                        </div>
