<div class="gradient-blobs">
    <div class="blob-violet"></div>
</div>

<% const projects=site.pages.filter(p=> p.layout === 'project').toArray().sort((a, b) => (b.order || 0) -
    (a.order || 0)); %>

<!-- Persists across Home / Playground (outside sliding #app-viewport) -->
<div class="sidebar-topbar-wrapper">
                <div class="sidebar-topbar-bg"></div>
                <div class="sidebar-topbar">
                    <nav class="sidebar-nav sidebar-accordion" aria-label="Site">
                        <div class="sidebar-accordion-item">
                            <button class="sidebar-accordion-toggle" aria-expanded="false">
                                <span class="sidebar-accordion-label">Recent works</span>
                                <span class="sidebar-accordion-icon">+</span>
                            </button>
                            <nav class="sidebar-accordion-content">
                                <% projects.forEach(function(project, index) { %>
                                    <a href="#project-<%= index %>" class="footer-link-item project-link-item">
                                        <%= project.short_title || project.title %>
                                    </a>
                                <% }); %>
                                <a href="#more-works" class="footer-link-item">More</a>
                            </nav>
                        </div>
                        <div class="sidebar-accordion-item">
                            <a href="#" class="sidebar-accordion-toggle" id="about-toggle">
                                <span class="sidebar-accordion-label">About</span>
                            </a>
                        </div>
                        <div class="sidebar-accordion-item">
                            <a href="#clients" class="sidebar-accordion-toggle sidebar-scroll-link">
                                <span class="sidebar-accordion-label">Clients</span>
                            </a>
                        </div>
                        <div class="sidebar-accordion-item sidebar-channels-item" aria-label="Channels">
                            <button class="sidebar-accordion-toggle sidebar-channels-toggle" aria-expanded="false" type="button">
                                <span class="sidebar-accordion-label">Channels</span>
                                <span class="sidebar-accordion-icon">+</span>
                            </button>
                            <nav class="sidebar-accordion-content sidebar-channels-content" aria-label="Social channels">
                                <% if (theme.social?.dribbble) { %>
                                    <a href="<%= theme.social.dribbble %>" target="_blank" rel="noopener noreferrer" aria-label="Dribbble" class="footer-link-item sidebar-social-link sidebar-social-link--dribbble">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm6.6 5.2a8 8 0 0 1 1.4 4.3 16.2 16.2 0 0 0-5.4-.2 25 25 0 0 0-.8-1.8 15.8 15.8 0 0 0 4.8-2.3ZM12 4a8 8 0 0 1 5.3 2 14 14 0 0 1-4.3 2.1 31.4 31.4 0 0 0-2.9-4A8 8 0 0 1 12 4ZM8.1 4.8a29 29 0 0 1 2.9 4 29.4 29.4 0 0 1-7 .8 8.1 8.1 0 0 1 4.1-4.8Zm-4.2 6.6a30 30 0 0 0 8-1 20 20 0 0 1 .7 1.5 12.5 12.5 0 0 0-6.9 5.2 8 8 0 0 1-1.8-5.7Zm8.1 8.7a8 8 0 0 1-4.9-1.7 10.6 10.6 0 0 1 6.1-4.8 33 33 0 0 1 1.7 5.9 8 8 0 0 1-2.9.6Zm4.6-1.6a36 36 0 0 0-1.6-5.3 14 14 0 0 1 4.8.3 8 8 0 0 1-3.2 5Z"/>
                                        </svg>
                                        <span class="sidebar-channel-label">Dribbble</span>
                                    </a>
                                <% } %>
                                <% if (theme.social?.behance) { %>
                                    <a href="<%= theme.social.behance %>" target="_blank" rel="noopener noreferrer" aria-label="Behance" class="footer-link-item sidebar-social-link sidebar-social-link--behance">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M14.8 6.8h5.5v1.4h-5.5V6.8ZM4 5.8h5.4c1.1 0 2 .3 2.6.8.6.5.9 1.2.9 2.1 0 .6-.1 1.1-.4 1.5-.3.4-.7.7-1.2.9.7.2 1.2.5 1.5 1 .4.5.5 1.1.5 1.9 0 1-.3 1.8-1 2.4-.7.6-1.7.9-2.9.9H4V5.8Zm5 4.6c.5 0 .9-.1 1.2-.4.3-.2.4-.6.4-1s-.1-.8-.4-1c-.3-.2-.7-.3-1.3-.3H6.3v2.7H9Zm.2 5c.6 0 1-.1 1.3-.4.3-.3.5-.7.5-1.2s-.2-.9-.5-1.2c-.3-.3-.8-.4-1.4-.4H6.3v3.2h2.9Zm9.1 2.2c-1.3 0-2.4-.4-3.2-1.2-.8-.8-1.2-1.9-1.2-3.3 0-1.4.4-2.5 1.2-3.3.8-.8 1.8-1.3 3.1-1.3s2.3.4 3 1.2c.7.8 1.1 2 1.1 3.5v.5h-6.1c.1.7.3 1.2.6 1.6.4.4.9.6 1.5.6.9 0 1.5-.4 1.8-1.1h2.1c-.2.9-.7 1.6-1.4 2.1-.6.5-1.5.7-2.5.7Zm1.9-5.3c-.1-.6-.3-1.1-.6-1.4-.3-.3-.8-.5-1.4-.5s-1 .2-1.4.5c-.3.3-.6.8-.7 1.4h4.1Z"/>
                                        </svg>
                                        <span class="sidebar-channel-label">Behance</span>
                                    </a>
                                <% } %>
                                <% if (theme.social?.twitter) { %>
                                    <a href="<%= theme.social.twitter %>" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="footer-link-item sidebar-social-link sidebar-social-link--twitter">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M17.6 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.3L5 21H1.9l7.3-8.3L1.5 3h6.5l4.4 5.7L17.6 3Zm-1.1 16.2h1.7L7 4.7H5.2l11.3 14.5Z"/>
                                        </svg>
                                        <span class="sidebar-channel-label">X</span>
                                    </a>
                                <% } %>
                                <% if (theme.social?.linkedin) { %>
                                    <a href="<%= theme.social.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-link-item sidebar-social-link sidebar-social-link--linkedin">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M5.1 8.8h3.2V19H5.1V8.8Zm1.6-5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6Zm4.1 5h3.1v1.4h.1c.4-.8 1.5-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V19h-3.2v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V19h-3.2V8.8Z"/>
                                        </svg>
                                        <span class="sidebar-channel-label">LinkedIn</span>
                                    </a>
                                <% } %>
                            </nav>
                        </div>
                        <div class="sidebar-accordion-item sidebar-playground-link">
                            <a href="#" class="sidebar-accordion-toggle navbar-playground-btn" id="navbar-playground-toggle">
                                <span class="sidebar-accordion-label">Playground</span>
                            </a>
                        </div>
                        <div class="sidebar-accordion-item sidebar-contact-link">
                            <a href="#connect" class="sidebar-accordion-toggle sidebar-scroll-link sidebar-contact-cta">
                                <span class="sidebar-accordion-label">Contact</span>
                            </a>
                        </div>
                    </nav>
                    <div class="sidebar-social-icons sidebar-social-icons--desktop" aria-label="Social links">
                        <% if (theme.social?.dribbble) { %>
                            <a href="<%= theme.social.dribbble %>" target="_blank" rel="noopener noreferrer" aria-label="Dribbble" class="sidebar-social-link sidebar-social-link--dribbble">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 2.2a9.8 9.8 0 1 0 0 19.6 9.8 9.8 0 0 0 0-19.6Zm6.6 5.2a8 8 0 0 1 1.4 4.3 16.2 16.2 0 0 0-5.4-.2 25 25 0 0 0-.8-1.8 15.8 15.8 0 0 0 4.8-2.3ZM12 4a8 8 0 0 1 5.3 2 14 14 0 0 1-4.3 2.1 31.4 31.4 0 0 0-2.9-4A8 8 0 0 1 12 4ZM8.1 4.8a29 29 0 0 1 2.9 4 29.4 29.4 0 0 1-7 .8 8.1 8.1 0 0 1 4.1-4.8Zm-4.2 6.6a30 30 0 0 0 8-1 20 20 0 0 1 .7 1.5 12.5 12.5 0 0 0-6.9 5.2 8 8 0 0 1-1.8-5.7Zm8.1 8.7a8 8 0 0 1-4.9-1.7 10.6 10.6 0 0 1 6.1-4.8 33 33 0 0 1 1.7 5.9 8 8 0 0 1-2.9.6Zm4.6-1.6a36 36 0 0 0-1.6-5.3 14 14 0 0 1 4.8.3 8 8 0 0 1-3.2 5Z"/>
                                </svg>
                            </a>
                        <% } %>
                        <% if (theme.social?.behance) { %>
                            <a href="<%= theme.social.behance %>" target="_blank" rel="noopener noreferrer" aria-label="Behance" class="sidebar-social-link sidebar-social-link--behance">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M14.8 6.8h5.5v1.4h-5.5V6.8ZM4 5.8h5.4c1.1 0 2 .3 2.6.8.6.5.9 1.2.9 2.1 0 .6-.1 1.1-.4 1.5-.3.4-.7.7-1.2.9.7.2 1.2.5 1.5 1 .4.5.5 1.1.5 1.9 0 1-.3 1.8-1 2.4-.7.6-1.7.9-2.9.9H4V5.8Zm5 4.6c.5 0 .9-.1 1.2-.4.3-.2.4-.6.4-1s-.1-.8-.4-1c-.3-.2-.7-.3-1.3-.3H6.3v2.7H9Zm.2 5c.6 0 1-.1 1.3-.4.3-.3.5-.7.5-1.2s-.2-.9-.5-1.2c-.3-.3-.8-.4-1.4-.4H6.3v3.2h2.9Zm9.1 2.2c-1.3 0-2.4-.4-3.2-1.2-.8-.8-1.2-1.9-1.2-3.3 0-1.4.4-2.5 1.2-3.3.8-.8 1.8-1.3 3.1-1.3s2.3.4 3 1.2c.7.8 1.1 2 1.1 3.5v.5h-6.1c.1.7.3 1.2.6 1.6.4.4.9.6 1.5.6.9 0 1.5-.4 1.8-1.1h2.1c-.2.9-.7 1.6-1.4 2.1-.6.5-1.5.7-2.5.7Zm1.9-5.3c-.1-.6-.3-1.1-.6-1.4-.3-.3-.8-.5-1.4-.5s-1 .2-1.4.5c-.3.3-.6.8-.7 1.4h4.1Z"/>
                                </svg>
                            </a>
                        <% } %>
                        <% if (theme.social?.twitter) { %>
                            <a href="<%= theme.social.twitter %>" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="sidebar-social-link sidebar-social-link--twitter">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M17.6 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.3L5 21H1.9l7.3-8.3L1.5 3h6.5l4.4 5.7L17.6 3Zm-1.1 16.2h1.7L7 4.7H5.2l11.3 14.5Z"/>
                                </svg>
                            </a>
                        <% } %>
                        <% if (theme.social?.linkedin) { %>
                            <a href="<%= theme.social.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="sidebar-social-link sidebar-social-link--linkedin">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M5.1 8.8h3.2V19H5.1V8.8Zm1.6-5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6Zm4.1 5h3.1v1.4h.1c.4-.8 1.5-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V19h-3.2v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V19h-3.2V8.8Z"/>
                                </svg>
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

<div id="app-viewport">
    <!-- VIEW 1: HOME (Hero + Work) -->
    <div id="home-view" class="app-view">
        <div class="portfolio-wrapper">
                <!-- Top header -->
                <section class="hero-section">
                    <div class="sidebar-intro">
                        <div class="sidebar-header">
                            <h1 class="sidebar-logo">michal sambora — sambø</h1>
                        </div>
                        <div class="sidebar-description-wrapper">
                            <h2 class="sidebar-description">
                                <span class="sidebar-description-line sidebar-description-line--desktop">Building refined digital products</span>
                                <span class="sidebar-description-line sidebar-description-line--desktop">in the age of AI</span>
                                <span class="sidebar-description-line sidebar-description-line--mobile">Building refined digital</span>
                                <span class="sidebar-description-line sidebar-description-line--mobile">products in the age of AI</span>
                            </h2>
                        </div>

                        <div class="sidebar-cta-wrapper">
                            <a href="<%= theme.connect?.cta?.link || 'https://calendly.com/sambora/30min' %>"
                                class="unicorn-btn sidebar-btn" target="_blank" rel="noopener noreferrer"
                                data-us-project-src="/button-sidebar.json" data-us-scale="0.6" data-us-dpi="4.0"
                                data-us-production="true">
                                <span class="btn-text">Schedule a call</span>
                            </a>
                            <a href="mailto:<%= theme.connect?.email || 'contact@msambora.com' %>"
                                class="sidebar-accordion-toggle copy-email-btn">
                                <svg class="sidebar-accordion-icon copy-email-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="9" y="9" width="10" height="10" rx="2" ry="2"></rect>
                                    <path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
                                </svg>
                                <span class="sidebar-accordion-label copy-email-text">email</span>
                            </a>
                        </div>
                        <a href="mailto:<%= theme.connect?.email || 'contact@msambora.com' %>"
                            class="footer-email-full copy-email-btn">
                            <%= theme.connect?.email || 'contact@msambora.com' %>
                        </a>
                    </div>
                </section>

                <!-- Right Content - Projects -->
                <main class="projects-column" id="projects">

                    <!-- ABOUT VIEW (hidden by default) -->
                    <div class="about-view" id="about-view">
                        <div class="about-back-row">
                            <a href="#" class="project-back" id="about-close">
                                <span class="project-back-icon" aria-hidden="true">&larr;</span>
                                <span class="project-back-label">Back</span>
                            </a>
                        </div>
                        <% if (theme.experience) { %>
                            <section class="about-section">
                                <h2 class="about-title">The Journey</h2>
                                <div class="about-intro" id="about-intro">
                                    <%= theme.experience.intro_variants[0] %>
                                </div>
                                <div class="experience-timeline">
                                    <% theme.experience.timeline.forEach(function(item) { %>
                                        <div class="timeline-item">
                                            <div class="timeline-marker"></div>
                                            <div class="timeline-content">
                                                <div class="timeline-header">
                                                    <span class="timeline-milestone"><%= item.milestone %></span>
                                                    <h4 class="timeline-title"><%= item.title %></h4>
                                                </div>
                                                <p class="timeline-text"><%= item.content %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </section>
                            <% if (theme.experience.roles) { %>
                                <section class="about-section about-list-section">
                                    <div class="cv-experience">
                                        <h3 class="cv-experience-heading">Experiences</h3>
                                        <div class="cv-experience-list">
                                            <% theme.experience.roles.forEach(function(role) { %>
                                                <div class="cv-experience-row">
                                                    <div class="cv-experience-role">
                                                        <h4 class="cv-experience-company"><%= role.company %></h4>
                                                        <p class="cv-experience-title"><%= role.title %></p>
                                                    </div>
                                                    <span class="cv-experience-period"><%= role.period %></span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </section>
                            <% } %>
                            <% if (theme.clients) { %>
                                <section class="about-section about-list-section">
                                    <%- partial('_partial/clients-section', { variant: 'about' }) %>
                                </section>
                            <% } %>
                            <% if (theme.events) { %>
                                <section class="about-section about-list-section">
                                    <div class="cv-experience">
                                        <h3 class="cv-experience-heading">Events</h3>
                                        <div class="cv-experience-list">
                                            <% theme.events.forEach(function(item) { %>
                                                <div class="cv-experience-row">
                                                    <div class="cv-experience-role">
                                                        <h4 class="cv-experience-company"><%= item.title %></h4>
                                                        <% if (item.role) { %>
                                                            <p class="cv-experience-label"><%= item.role %></p>
                                                        <% } %>
                                                        <% if (item.description) { %>
                                                            <p class="cv-experience-title"><%= item.description %></p>
                                                        <% } %>
                                                    </div>
                                                    <span class="cv-experience-period"><%= item.year %></span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </section>
                            <% } %>
                            <div class="resume-hover-preview">
                                <div class="preview-content">
                                    <div class="preview-media">
                                        <img src="" alt="" class="preview-image">
                                    </div>
                                    <div class="preview-text">
                                        <div class="preview-header">
                                            <span class="preview-year"></span>
                                            <h4 class="preview-title"></h4>
                                        </div>
                                        <p class="preview-description"></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Main content (projects + more works + connect) -->
                    <div class="projects-main-content" id="projects-main-content">
                    <% projects.forEach(function(project, pindex) { %>
                        <% const carouselStyle=[ project.carousel_aspect_ratio ?
                            `\--carousel-aspect-ratio:${project.carousel_aspect_ratio};` : '' ,
                            project.carousel_object_fit ? `\--carousel-object-fit:${project.carousel_object_fit};` : ''
                            , project.carousel_object_position ?
                            `\--carousel-object-position:${project.carousel_object_position};` : '' ,
                            project.carousel_image_scale ? `\--carousel-image-scale:${project.carousel_image_scale};`
                            : '' , project.carousel_image_height ?
                            `\--carousel-image-height:${project.carousel_image_height};` : '' ,
                            project.carousel_image_top ? `\--carousel-image_top:${project.carousel_image_top};` : '' ,
                            ].join(''); %>
                            <% const firstCarouselItem = project.carousel && project.carousel[0]; %>
                            <% const firstCarouselIsJson = firstCarouselItem && (
                              typeof firstCarouselItem === 'string'
                                ? firstCarouselItem.endsWith('.json')
                                : (firstCarouselItem.light && String(firstCarouselItem.light).endsWith('.json'))
                            ); %>
                            <% const useCustomShaderCarousel = project.carousel && project.carousel.length && !project.preview_slideshow; %>
                            <% const showCarouselHint = ['hydration', 'hydradx'].includes(String(project.short_title || project.title || '').toLowerCase()); %>
                            <% const needsTopbarLight = Boolean(project.topbar_light || firstCarouselIsJson); %>
                            <section class="project-section reveal-on-scroll" id="project-<%= pindex %>"
                                data-project-index="<%= pindex %>"<% if (needsTopbarLight) { %> data-topbar-light="true"<% } %><% if (carouselStyle) { %>
                                style="<%- carouselStyle %>"<% } %>>
                                        <div class="project-carousel-wrapper"<% if (project.disable_parallax) { %> data-disable-parallax="true"<% } %><% if (needsTopbarLight) { %> data-topbar-light="true"<% } %>>
                                                <!-- Navigation Zones -->
                                                <div class="carousel-nav-zone carousel-nav-zone--left" data-nav="prev">
                                                </div>
                                                <div class="carousel-nav-zone carousel-nav-zone--right" data-nav="next">
                                                </div>

                                                <div class="<%= useCustomShaderCarousel ? 'custom-shader-carousel' : 'embla' %><%= showCarouselHint ? ' has-scroll-hint' : '' %>">
                                                    <% if (showCarouselHint) { %>
                                                        <span class="carousel-scroll-hint" aria-hidden="true">← →</span>
                                                    <% } %>
                                                    <div class="<%= useCustomShaderCarousel ? 'custom-shader-viewport' : 'embla__viewport' %>">
                                                        <div class="<%= useCustomShaderCarousel ? 'custom-shader-track' : 'embla__container' %>">
                                                            <% if (project.carousel && project.carousel.length) { %>
                                                                <% if (project.preview_slideshow) { %>
                                                                    <% const previewSrcs = (project.preview_extra || []).map(function(src) { return url_for(src); }).concat(
                                                                        project.carousel
                                                                        .filter(function(item) {
                                                                            const src = (typeof item === 'object' && item !== null) ? item.light : item;
                                                                            return src && !src.endsWith('.json');
                                                                        })
                                                                        .map(function(item) {
                                                                            return url_for((typeof item === 'object' && item !== null) ? item.light : item);
                                                                        })
                                                                    ); %>
                                                                    <div class="embla__slide preview-slideshow-slide is-active-slide"
                                                                        data-preview-srcs='<%- JSON.stringify(previewSrcs) %>'>
                                                                        <div class="project-slide-item">
                                                                            <div class="image-container loaded">
                                                                                <img class="preview-slideshow-img"
src="<%- previewSrcs[0] || '' %>"
                                                                                    alt="<%= project.title %>"
                                                                                    decoding="async"
                                                                                    draggable="false">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                <% } %>
                                                                <% const carouselItems = (!project.preview_slideshow && project.carousel.length < 5)
                                                                    ? Array.from({ length: Math.ceil(6 / project.carousel.length) })
                                                                        .flatMap(function() { return project.carousel; })
                                                                        .slice(0, 6)
                                                                    : project.carousel; %>
                                                                <% carouselItems.forEach(function(imgUrl, slideIndex)
                                                                    { %>
                                                                    <% const
                                                                        firstStyle=(project.carousel_first_object_position
                                                                        && slideIndex===0) ?
                                                                        `style="\--carousel-object-position:${project.carousel_first_object_position};"
                                                                        ` : '' ; %>
                                                                    <% const mobileStaticItem=(project.mobile_first_slide
                                                                        && slideIndex===0) ? project.mobile_first_slide :
                                                                        null; %>
                                                                        <div class="<%= useCustomShaderCarousel ? 'custom-shader-slide' : 'embla__slide' %><%= (!project.preview_slideshow && slideIndex === 0) ? ' is-active-slide' : '' %>" <%=firstStyle %>>
                                                                            <div class="project-slide-item<%= mobileStaticItem ? ' has-mobile-static-first' : '' %>">
                                                                                <% const isObject=typeof
                                                                                    imgUrl==='object' && imgUrl !==null;
                                                                                    const lightItem=isObject ?
                                                                                    imgUrl.light : imgUrl; const
                                                                                    darkItem=isObject ? imgUrl.dark :
                                                                                    null; const isJson=(lightItem &&
                                                                                    lightItem.endsWith('.json')); %>
                                                                                    <% if (isJson) { %>
                                                                                        <% const staticPosterItem = mobileStaticItem || project.cover || project.hero_image; %>
                                                                                        <% if (mobileStaticItem) { %>
                                                                                            <div class="image-container mobile-static-first-slide loaded">
                                                                                                <img src="<%- url_for(mobileStaticItem) %>"
                                                                                                    alt="<%= project.title %>"
                                                                                                    loading="<%= pindex === 0 ? 'eager' : 'lazy' %>"
                                                                                                    decoding="async"
                                                                                                    <%=pindex===0
                                                                                                    ? 'fetchpriority="high"'
                                                                                                    : '' %>
                                                                                                    draggable="false">
                                                                                            </div>
                                                                                        <% } %>
                                                                                        <div class="unicorn-scene"
