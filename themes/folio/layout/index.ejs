<div class="gradient-blobs">
    <div class="blob-violet"></div>
</div>
<div class="portfolio-wrapper">
    <% const projects=site.pages.filter(p=> p.layout === 'project').toArray().sort((a, b) => (b.order || 0) - (a.order
        || 0)); %>
        <!-- Left Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-content">
                <div class="sidebar-hero">
                    <span class="project-link-item" style="text-transform: lowercase; border-bottom: none;">sambø</span>
                </div>
                <h1 class="sidebar-title">
                    <%= theme.hero_title || "I'm  Michal Sambora" %>
                </h1>

                <!-- Work Links (Collapsible) -->
                <div class="project-links">
                    <button class="project-links-toggle" aria-expanded="false" aria-controls="work-list">
                        <span class="project-links-label">Work</span>
                        <span class="toggle-arrow">↓</span>
                    </button>
                    <div class="project-links-list collapsed" id="work-list">
                        <% projects.forEach(function(project, index) { %>
                            <a href="#project-<%= index %>" class="project-link-item">
                                <%= project.title %>
                            </a>
                            <% }); %>
                    </div>
                </div>

                <hr class="sidebar-separator">

                <!-- Navigation Links -->
                <div class="nav-links">
                    <% if (theme.experience) { %>
                        <a href="#experience" class="project-link-item">Experience</a>
                        <% } %>
                            <a href="#connect" class="project-link-item">Let's connect</a>
                </div>
            </div>

            <div class="sidebar-footer">
                <div class="social-icons">
                    <% if (theme.social?.twitter) { %><a href="<%= theme.social.twitter %>" target="_blank">𝕏</a>
                        <% } %>
                            <% if (theme.social?.linkedin) { %><a href="<%= theme.social.linkedin %>"
                                    target="_blank">in</a>
                                <% } %>
                                    <% if (theme.social?.dribbble) { %><a href="<%= theme.social.dribbble %>"
                                            target="_blank">◉</a>
                                        <% } %>
                                            <% if (theme.social?.github) { %><a href="<%= theme.social.github %>"
                                                    target="_blank">⌘</a>
                                                <% } %>
                </div>

                <div class="sidebar-contact">
                    <a href="mailto:michal@maise.io" class="sidebar-email">michal@maise.io</a>
                </div>
            </div>
        </aside>

        <!-- Right Content - Projects -->
        <main class="projects-column" id="projects">
            <% projects.forEach(function(project, index) { %>
                <% const carouselStyle=[ project.carousel_aspect_ratio ?
                    `--carousel-aspect-ratio:${project.carousel_aspect_ratio};` : '' , project.carousel_object_fit ?
                    `--carousel-object-fit:${project.carousel_object_fit};` : '' , project.carousel_object_position ?
                    `--carousel-object-position:${project.carousel_object_position};` : '' ,
                    project.carousel_image_scale ? `--carousel-image-scale:${project.carousel_image_scale};` : '' ,
                    project.carousel_image_height ? `--carousel-image-height:${project.carousel_image_height};` : '' ,
                    project.carousel_image_top ? `--carousel-image_top:${project.carousel_image_top};` : '' ,
                    ].join(''); %>
                    <section class="project-section" id="project-<%= index %>" <% if (carouselStyle) { %> style="<%-
                            carouselStyle %>"<% } %>>
                                <div class="project-carousel-wrapper">
                                    <!-- Navigation Zones -->
                                    <div class="carousel-nav-zone carousel-nav-zone--left" data-nav="prev"></div>
                                    <div class="carousel-nav-zone carousel-nav-zone--right" data-nav="next"></div>

                                    <div class="embla">
                                        <div class="embla__viewport">
                                            <div class="embla__container">
                                                <% if (project.carousel && project.carousel.length) { %>
                                                    <% project.carousel.forEach(function(imgUrl, slideIndex) { %>
                                                        <% const firstStyle=(project.carousel_first_object_position &&
                                                            slideIndex===0) ? `
                                                            style="--carousel-object-position:${project.carousel_first_object_position};"
                                                            ` : '' ; %>
                                                            <div class="embla__slide" <%=firstStyle %>>
                                                                <a href="<%- url_for(project.path) %>"
                                                                    class="project-slide-link">
                                                                    <% if (imgUrl.endsWith('.json')) { %>
                                                                        <div class="unicorn-scene"
                                                                            data-us-project-src="<%- url_for(imgUrl) %>"
                                                                            data-us-scale="1" data-us-dpi="1.5"
                                                                            data-us-lazyload="true"
                                                                            data-us-production="true">
                                                                            <div class="unicorn-scene-skeleton"></div>
                                                                        </div>
                                                                        <% } else { %>
                                                                            <div class="image-container">
                                                                                <div class="image-skeleton"></div>
                                                                                <% if (project.blur) { %>
                                                                                    <div class="image-placeholder"
                                                                                        style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                    </div>
                                                                                    <% } %>
                                                                                        <img src="<%- url_for(imgUrl) %>"
                                                                                            alt="<%= project.title %>"
                                                                                            loading="lazy"
                                                                                            draggable="false"
                                                                                            onload="this.parentElement.classList.add('loaded')">
                                                                            </div>
                                                                            <% } %>
                                                                </a>
                                                            </div>
                                                            <% }); %>
                                                                <% } else if (project.cover) { %>
                                                                    <div class="embla__slide">
                                                                        <a href="<%- url_for(project.path) %>"
                                                                            class="project-slide-link">
                                                                            <div class="image-container">
                                                                                <div class="image-skeleton"></div>
                                                                                <% if (project.blur) { %>
                                                                                    <div class="image-placeholder"
                                                                                        style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                    </div>
                                                                                    <% } %>
                                                                                        <img src="<%- url_for(project.cover) %>"
                                                                                            alt="<%= project.title %>"
                                                                                            loading="lazy"
                                                                                            draggable="false"
                                                                                            onload="this.parentElement.classList.add('loaded')">
                                                                            </div>
                                                                        </a>
                                                                    </div>
                                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="carousel-scroll-hint" aria-hidden="true">Scroll ↔</span>
                                </div>
                                <div class="project-carousel-progress" aria-hidden="true">
                                    <span></span>
                                </div>
                                <div class="project-info">
                                    <div class="project-info-header">
                                        <h3 class="project-title">
                                            <%= project.title %>
                                        </h3>
                                        <% if (project.intro) { %>
                                            <p class="project-subtitle">
                                                <%= project.intro %>
                                            </p>
                                            <% } %>
                                    </div>
                                    <div class="project-info-left">
                                        <% if (project.problem) { %>
                                            <div class="project-info-section">
                                                <h4 class="project-info-heading">Problem</h4>
                                                <p class="project-info-text">
                                                    <%= project.problem %>
                                                </p>
                                            </div>
                                            <% } %>
                                                <% if (project.scope && project.scope.length) { %>
                                                    <div class="project-info-section">
                                                        <h4 class="project-info-heading">Scope</h4>
                                                        <ul class="project-info-list">
                                                            <% project.scope.forEach(function(item) { %>
                                                                <li>
                                                                    <%= item %>
                                                                </li>
                                                                <% }); %>
                                                        </ul>
                                                    </div>
                                                    <% } %>
                                    </div>
                                    <div class="project-info-right">
                                        <% if (project.solution) { %>
                                            <div class="project-info-section">
                                                <h4 class="project-info-heading">Solution</h4>
                                                <p class="project-info-text">
                                                    <%= project.solution %>
                                                </p>
                                            </div>
                                            <% } %>
                                                <div class="project-info-section">
                                                    <h4 class="project-info-heading">When</h4>
                                                    <p class="project-info-text">
                                                        <%= project.when || project.date_label || project.year || '—' %>
                                                    </p>
                                                </div>
                                    </div>
                                </div>
                    </section>
                    <% }); %>

                        <!-- EXPERIENCE SECTION -->
                        <% if (theme.experience) { %>
                            <section class="content-section" id="experience">
                                <div class="section-header">
                                    <h2 class="project-title">The Journey</h2>
                                </div>
                                <div class="experience-intro" id="experience-intro">
                                    <!-- JS will populate this -->
                                    <%= theme.experience.intro_variants[0] %>
                                </div>
                                <script>
                                    (function () {
                                        const variants = <% - JSON.stringify(theme.experience.intro_variants) %>;
                                        const randomIndex = Math.floor(Math.random() * variants.length);
                                        document.getElementById('experience-intro').textContent = variants[randomIndex];
                                    })();
                                </script>

                                <div class="experience-timeline">
                                    <% theme.experience.timeline.forEach(function(item) { %>
                                        <div class="timeline-item">
                                            <div class="timeline-marker"></div>
                                            <div class="timeline-content">
                                                <div class="timeline-header">
                                                    <span class="timeline-milestone">
                                                        <%= item.milestone %>
                                                    </span>
                                                    <h4 class="timeline-title">
                                                        <%= item.title %>
                                                    </h4>
                                                </div>
                                                <p class="timeline-text">
                                                    <%= item.content %>
                                                </p>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>

                                <div class="resume-lists-grid">
                                    <% if (theme.speaking) { %>
                                        <div class="resume-list-column">
                                            <h2 class="resume-section-heading">Speaking</h2>
                                            <ul class="resume-list">
                                                <% theme.speaking.forEach(function(item) { %>
                                                    <li>
                                                        <span class="resume-item-title">
                                                            <%= item.title %>
                                                        </span>
                                                        <span class="resume-item-year">
                                                            <%= item.year %>
                                                        </span>
                                                    </li>
                                                    <% }); %>
                                            </ul>
                                        </div>
                                        <% } %>

                                            <% if (theme.events) { %>
                                                <div class="resume-list-column">
                                                    <h2 class="resume-section-heading">Events</h2>
                                                    <ul class="resume-list">
                                                        <% theme.events.forEach(function(item) { %>
                                                            <li>
                                                                <span class="resume-item-title">
                                                                    <%= item.title %>
                                                                </span>
                                                                <span class="resume-item-year">
                                                                    <%= item.year %>
                                                                </span>
                                                            </li>
                                                            <% }); %>
                                                    </ul>
                                                </div>
                                                <% } %>
                                </div>
                            </section>
                            <% } %>

                                <!-- CONNECT SECTION -->
                                <% if (theme.connect) { %>
                                    <section class="content-section" id="connect">
                                        <div class="connect-wrapper">
                                            <h2 class="project-title">
                                                <%= theme.connect.title %>
                                            </h2>
                                            <div class="connect-content">
                                                <div class="connect-main">
                                                    <p class="project-info-text section-intro">
                                                        <%= theme.connect.intro %>
                                                    </p>

                                                    <a href="<%= theme.connect.cta.link %>" class="unicorn-btn"
                                                        data-us-project-src="/button.json" data-us-scale="1"
                                                        data-us-dpi="1.5" data-us-production="true" target="_blank"
                                                        rel="noopener">
                                                        <span class="btn-text">
                                                            <%= theme.connect.cta.text %>
                                                        </span>
                                                    </a>
                                                </div>

                                                <div class="connect-side">
                                                    <div class="connect-secondary">
                                                        <p class="project-info-text">
                                                            <%= theme.connect.secondary_text %>
                                                        </p>
                                                        <a href="<%= theme.connect.guide_link.link %>"
                                                            class="connect-link">
                                                            <%= theme.connect.guide_link.text %>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="connect-footer-bottom">
                                                <a href="mailto:<%= theme.connect.email %>"
                                                    class="connect-footer-email">
                                                    <%= theme.connect.email %>
                                                </a>
                                                <div class="connect-footer-socials">
                                                    <% if (theme.social?.twitter) { %><a
                                                            href="<%= theme.social.twitter %>"
                                                            target="_blank">Twitter</a>
                                                        <% } %>
                                                            <% if (theme.social?.linkedin) { %><a
                                                                    href="<%= theme.social.linkedin %>"
                                                                    target="_blank">Linkedin</a>
                                                                <% } %>
                                                                    <% if (theme.social?.github) { %><a
                                                                            href="<%= theme.social.github %>"
                                                                            target="_blank">Github</a>
                                                                        <% } %>
                                                                            <% if (theme.social?.dribbble) { %><a
                                                                                    href="<%= theme.social.dribbble %>"
                                                                                    target="_blank">Dribbble</a>
                                                                                <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <% } %>
        </main>
</div>