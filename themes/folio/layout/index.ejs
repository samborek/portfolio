<script>
    // Preview slideshow: cycle through slide images on the first slide
    document.querySelectorAll('.preview-slideshow-slide').forEach(function (slide) {
        const srcs = JSON.parse(slide.dataset.previewSrcs || '[]');
        if (srcs.length < 2) return;
        const img = slide.querySelector('.preview-slideshow-img');
        if (!img) return;
        let idx = 0;
        setInterval(function () {
            idx = (idx + 1) % srcs.length;
            img.src = srcs[idx];
        }, 1200);
    });

    // Dribbble grid: load assets after main content, then enable hover interactions
    function initDribbbleGrid() {
        const isHover = window.matchMedia('(hover: hover)').matches;

        document.querySelectorAll('.dribbble-grid-item img[data-src]').forEach(img => {
            img.src = img.dataset.src;
            img.removeAttribute('data-src');
        });

        document.querySelectorAll('.dribbble-grid-item video[data-src]').forEach(video => {
            video.src = video.dataset.src;
            video.removeAttribute('data-src');
        });

        if (isHover) {
            document.querySelectorAll('.dribbble-grid-item video').forEach(video => {
                const tile = video.closest('.dribbble-grid-item');
                tile.addEventListener('mouseenter', () => video.play());
                tile.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
            });

            document.querySelectorAll('.dribbble-grid-item img[src$=".gif"]').forEach(img => {
                const tile = img.closest('.dribbble-grid-item');
                const canvas = document.createElement('canvas');
                canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;';
                img.parentElement.style.position = 'relative';

                const freeze = () => {
                    canvas.width = img.naturalWidth;
                    canvas.height = img.naturalHeight;
                    canvas.getContext('2d').drawImage(img, 0, 0);
                    img.parentElement.appendChild(canvas);
                };

                img.addEventListener('load', freeze);

                tile.addEventListener('mouseenter', () => canvas.style.display = 'none');
                tile.addEventListener('mouseleave', () => {
                    canvas.style.display = '';
                    const src = img.src;
                    img.src = '';
                    img.src = src;
                });
            });
        } else {
            const videoObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const video = entry.target.querySelector('video');
                    if (!video) return;

                    video.muted = true;
                    video.playsInline = true;
                    video.setAttribute('playsinline', '');
                    video.setAttribute('webkit-playsinline', '');

                    if (entry.isIntersecting) {
                        video.play().catch(() => { });
                    } else {
                        video.pause();
                    }
                });
            }, { rootMargin: '120px 0px', threshold: 0.25 });

            document.querySelectorAll('.dribbble-grid-item video').forEach(video => {
                videoObserver.observe(video.closest('.dribbble-grid-item'));
            });
        }
    }

    if (document.readyState === 'complete') {
        initDribbbleGrid();
    } else {
        window.addEventListener('load', initDribbbleGrid);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const viewport = document.getElementById('app-viewport');
        const homeView = document.getElementById('home-view');
        const playgroundView = document.getElementById('playground-view');

        const isPlaygroundActive = () => homeView && homeView.getAttribute('aria-hidden') === 'true';

        const ensureHomeView = (callback) => {
            if (!isPlaygroundActive()) {
                callback();
                return;
            }
            const homeTab = document.querySelector('.tab-button[data-tab="home"]');
            if (homeTab) {
                homeTab.click();
                setTimeout(callback, 780);
            } else {
                callback();
            }
        };

        const tabButtons = document.querySelectorAll('.tab-button');
        const tabIndicator = document.querySelector('.tab-indicator');
        const floatControls = document.querySelector('.floating-controls');
        const isMobile = () => window.innerWidth <= 768;

        // --- About View Toggle ---
        const aboutToggle = document.getElementById('about-toggle');
        const aboutClose = document.getElementById('about-close');
        const aboutView = document.getElementById('about-view');
        const mainContent = document.getElementById('projects-main-content');

        const fadeDuration = 250;

        function fadeOut(el) {
            el.style.opacity = '0';
        }

        function fadeIn(el) {
            requestAnimationFrame(() => { el.style.opacity = '1'; });
        }

        function switchToAbout() {
            document.body.classList.add('about-mode');
            fadeOut(mainContent);
            setTimeout(() => {
                mainContent.classList.add('is-hidden');
                aboutView.classList.add('is-active');
                homeView.scrollTop = 0;
                document.getElementById('projects').scrollTop = 0;
                fadeIn(aboutView);
            }, fadeDuration);
        }

        function switchToMain(scrollTarget) {
            fadeOut(aboutView);
            setTimeout(() => {
                aboutView.classList.remove('is-active');
                mainContent.classList.remove('is-hidden');
                document.body.classList.remove('about-mode');
                fadeIn(mainContent);
                if (scrollTarget) {
                    setTimeout(() => {
                        scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 50);
                }
                setTimeout(() => {
                    document.dispatchEvent(new CustomEvent('folio:work-visible'));
                    window.dispatchEvent(new Event('resize'));
                    window.dispatchEvent(new MouseEvent('mousemove', { clientX: window.innerWidth / 2, clientY: window.innerHeight / 2 }));
                    setTimeout(() => {
                        document.dispatchEvent(new CustomEvent('folio:work-visible'));
                    }, 250);
                }, fadeDuration + 100);
            }, fadeDuration);
        }

        if (aboutToggle) aboutToggle.addEventListener('click', (e) => {
            e.preventDefault();
            ensureHomeView(() => {
                if (aboutView.classList.contains('is-active')) {
                    switchToMain();
                } else {
                    switchToAbout();
                }
            });
        });

        // --- Playground Toggle from Navbar ---
        const navbarPlaygroundToggle = document.getElementById('navbar-playground-toggle');
        if (navbarPlaygroundToggle) {
            navbarPlaygroundToggle.addEventListener('click', function (e) {
                e.preventDefault();
                const playgroundTabBtn = document.querySelector('.floating-controls .tab-button[data-tab="playground"]');
                if (playgroundTabBtn) {
                    playgroundTabBtn.click();
                }
            });
        }
        if (aboutClose) aboutClose.addEventListener('click', (e) => {
            e.preventDefault();
            switchToMain();
        });

        // Close About when clicking any sidebar project/section link
        document.querySelectorAll('.sidebar-accordion-content .footer-link-item').forEach(link => {
            link.addEventListener('click', () => {
                ensureHomeView(() => {
                    if (aboutView.classList.contains('is-active')) {
                        switchToMain();
                    }
                });
            });
        });

        // --- Section scroll links (Contact, Cooperate, etc.) ---
        const collabSection = document.getElementById('collab-section');

        function openCollabSection() {
            if (collabSection && !collabSection.classList.contains('is-open')) {
                collabSection.classList.add('is-open');
            }
        }

        document.querySelectorAll('.sidebar-scroll-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const shouldOpenCollab = link.hasAttribute('data-open-collab');
                const href = link.getAttribute('href');
                const target = document.querySelector(href) || (shouldOpenCollab ? document.getElementById('connect') : null);

                const scrollToTarget = () => {
                    if (shouldOpenCollab) {
                        openCollabSection();
                    }
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                };

                ensureHomeView(() => {
                    if (aboutView.classList.contains('is-active')) {
                        switchToMain(target);
                        if (shouldOpenCollab) {
                            setTimeout(openCollabSection, fadeDuration + 80);
                        }
                    } else {
                        scrollToTarget();
                    }
                });
            });
        });

        // --- More Work Strip scroll fade ---
        const strip = document.querySelector('.more-work-strip');
        if (strip) {
            const wrapper = strip.parentElement;
            wrapper.style.position = 'relative';

            const fadeL = document.createElement('div');
            const fadeR = document.createElement('div');
            const fadeBase = 'position:absolute;top:0;bottom:0;width:60px;pointer-events:none;z-index:2;opacity:0;transition:opacity 0.4s ease;';
            fadeL.style.cssText = fadeBase + `left:0;background:linear-gradient(to right, var(--color-bg), transparent);`;
            fadeR.style.cssText = fadeBase + `right:0;background:linear-gradient(to left, var(--color-bg), transparent);`;
            wrapper.appendChild(fadeL);
            wrapper.appendChild(fadeR);

            let stripFadeTimer = null;

            function updateStripFade() {
                const sl = strip.scrollLeft;
                const sr = strip.scrollWidth - strip.clientWidth - sl;
                fadeL.style.opacity = sl > 2 ? '1' : '0';
                fadeR.style.opacity = sr > 2 ? '1' : '0';

                clearTimeout(stripFadeTimer);
                stripFadeTimer = setTimeout(() => {
                    fadeL.style.opacity = '0';
                    fadeR.style.opacity = '0';
                }, 800);
            }

            strip.addEventListener('scroll', updateStripFade);
        }

        // --- Collaboration Toggle ---
        const collabToggle = document.getElementById('collab-toggle');
        const collabClose = document.getElementById('collab-close');
        function toggleCollab(e) {
            e.preventDefault();
            const isOpen = collabSection.classList.toggle('is-open');
            if (isOpen) {
                setTimeout(() => {
                    collabSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }
        }
        if (collabToggle && collabSection) {
            collabToggle.addEventListener('click', toggleCollab);
        }
        if (collabClose && collabSection) {
            collabClose.addEventListener('click', toggleCollab);
        }

        // --- View & Scroll Management ---
        let activeView = homeView;
        let scrollListeners = new Map();

        // Register hover handler for controls
        floatControls.addEventListener('mouseenter', () => {
            floatControls.classList.remove('controls-hidden');
            const handler = scrollListeners.get(activeView);
            if (handler) {
                clearTimeout(handler.timer);
            }
        });

        // Scroll handler factory
        const createScrollHandler = (viewElement) => {
            let lastScrollY = 0;
            const threshold = 10; // Minimum scroll distance to trigger a change

            const handler = () => {
                const currentScrollY = viewElement.scrollTop;
                const scrollDiff = Math.abs(currentScrollY - lastScrollY);

                if (scrollDiff < threshold) return;

                // If scrolling down, hide
                if (currentScrollY > lastScrollY && currentScrollY > 100) {
                    floatControls.classList.add('controls-hidden');
                } else if (currentScrollY < lastScrollY) {
                    // If scrolling up, show
                    floatControls.classList.remove('controls-hidden');
                }

                // If at the very top, always show
                if (currentScrollY <= 10) {
                    floatControls.classList.remove('controls-hidden');
                }

                lastScrollY = currentScrollY;

                // Show after scrolling stops
                clearTimeout(handler.timer);
                handler.timer = setTimeout(() => {
                    floatControls.classList.remove('controls-hidden');
                }, 1200); // Wait longer before auto-showing
            };
            handler.timer = null;
            return handler;
        };

        // Initialize scroll handlers for both views
        [homeView, playgroundView].forEach(view => {
            const handler = createScrollHandler(view);
            scrollListeners.set(view, handler);
            // Verify: Should we listen on 'scroll' for both? Yes.
            // But we only want the active one to affect the controls? 
            // Or both? For now, let's attach to both but maybe only active matters?
            // Simpler: attach to both. If you scroll the hidden one (inactive), 
            // it might hide controls which is weird but rare (momentum).
            // Let's attach actively when switching.
        });

        const attachScrollListener = (view) => {
            [homeView, playgroundView].forEach(v => {
                const h = scrollListeners.get(v);
                v.removeEventListener('scroll', h);
            });
            const handler = scrollListeners.get(view);
            view.addEventListener('scroll', handler, { passive: true });
        };

        // Start with Home
        attachScrollListener(homeView);

        // --- Navigation Logic ---
        const updateIndicator = (activeBtn) => {
            if (!tabIndicator || !activeBtn) return;
            const rect = activeBtn.getBoundingClientRect();
            const parentRect = activeBtn.parentElement.getBoundingClientRect();
            tabIndicator.style.width = `${rect.width}px`;
            tabIndicator.style.transform = `translateX(${rect.left - parentRect.left}px)`;
        };

        const showFloatingControls = () => {
            if (floatControls) {
                floatControls.classList.add('controls-ready');
            }
        };

        // Initial indicator
        const initialActive = document.querySelector('.tab-button.active');
        if (initialActive) {
            const settleInitialIndicator = () => {
                updateIndicator(initialActive);
                requestAnimationFrame(showFloatingControls);
            };

            if (document.fonts && document.fonts.ready) {
                document.fonts.ready
                    .then(() => setTimeout(settleInitialIndicator, 100))
                    .catch(settleInitialIndicator);
            } else {
                settleInitialIndicator();
            }
        } else {
            showFloatingControls();
        }

        // Initialize aria-hidden
        homeView.setAttribute('aria-hidden', 'false');
        playgroundView.setAttribute('aria-hidden', 'true');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const tab = button.dataset.tab;
                const currentActiveBtn = document.querySelector('.tab-button.active');
                if (currentActiveBtn === button) return;

                // Update Buttons
                tabButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                updateIndicator(button);

                // Slide Viewport & Manage Visibility
                if (tab === 'playground') {
                    viewport.style.transform = 'translateX(-50%)';
                    activeView = playgroundView;
                    playgroundView.setAttribute('aria-hidden', 'false');
                    homeView.setAttribute('aria-hidden', 'true');

                    // Wake up playground
                    setTimeout(() => {
                        window.dispatchEvent(new Event('resize'));
                        // Trigger mousemove to wake unicorn
                        window.dispatchEvent(new MouseEvent('mousemove', {
                            clientX: window.innerWidth / 2,
                            clientY: window.innerHeight / 2,
                            bubbles: true
                        }));
                    }, 750); // > 0.7s transition
                } else {
                    viewport.style.transform = 'translateX(0)';
                    activeView = homeView;
                    homeView.setAttribute('aria-hidden', 'false');
                    playgroundView.setAttribute('aria-hidden', 'true');

                    // Wake up Unicorn Studio canvases
                    setTimeout(() => {
                        window.dispatchEvent(new Event('resize'));
                        window.dispatchEvent(new MouseEvent('mousemove', {
                            clientX: window.innerWidth / 2,
                            clientY: window.innerHeight / 2,
                            bubbles: true
                        }));
                    }, 750);
                }

                // Update Scroll Listener
                attachScrollListener(activeView);
                // Ensure controls are visible when switching
                floatControls.classList.remove('controls-hidden');
            });
        });

        window.addEventListener('resize', () => {
            const btn = document.querySelector('.tab-button.active');
            if (btn) updateIndicator(btn);
        });

        // --- Video Lazy Loading (Playground) ---
        const loadVideo = (item) => {
            const video = item.querySelector('video');
            const src = item.dataset.videoSrc;
            if (video && !video.src) {
                video.src = src;
                video.load();
                const checkLoaded = () => {
                    if (video.readyState >= 2) {
                        video.classList.add('loaded');
                        video.removeEventListener('loadeddata', checkLoaded);
                    }
                };
                if (video.readyState >= 2) checkLoaded();
                else video.addEventListener('loadeddata', checkLoaded);
            }
        };

        const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) loadVideo(entry.target);
            });
        }, { root: playgroundView, rootMargin: '200px', threshold: 0.01 }); // Root is now playgroundView? Or null? relative to viewport yes.

        // Mobile Focus
        const mobileFocusObserver = new IntersectionObserver((entries) => {
            if (!isMobile()) return;
            entries.forEach(entry => {
                const video = entry.target.querySelector('video');
                if (video) {
                    if (entry.isIntersecting) video.play().catch(() => { });
                    else {
                        video.pause();
                        video.currentTime = 0;
                    }
                }
            });
        }, { root: playgroundView, threshold: 0.7 });

        const videoItems = document.querySelectorAll('.playground-item');
        videoItems.forEach(item => {
            videoObserver.observe(item);
            mobileFocusObserver.observe(item);

            item.addEventListener('mouseenter', () => {
                if (isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    if (video.readyState >= 2) video.play().catch(() => { });
                    else {
                        loadVideo(item);
                        video.addEventListener('loadeddata', () => {
                            video.play().catch(() => { });
                        }, { once: true });
                    }
                }
            });
            item.addEventListener('mouseleave', () => {
                if (isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    video.pause();
                    video.currentTime = 0;
                }
            });
            item.addEventListener('click', () => {
                if (!isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    if (video.paused) video.play().catch(() => { });
                    else video.pause();
                }
            });
        });
    });
</script>
