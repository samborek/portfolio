<div class="gradient-blobs">
    <div class="blob-violet"></div>
</div>

<div id="app-viewport">
    <!-- VIEW 1: HOME (Sidebar + Work) -->
    <div id="home-view" class="app-view">
        <div class="portfolio-wrapper">
            <% const projects=site.pages.filter(p=> p.layout === 'project').toArray().sort((a, b) => (b.order || 0) -
                (a.order || 0)); %>

                <!-- Left Sidebar -->
                <aside class="sidebar">
                    <div class="sidebar-header">
                        <h1 class="sidebar-logo">michal sambora — sambø</h1>
                    </div>

                    <div class="sidebar-body">
                        <h2 class="sidebar-description">
                            Building digital products & exploring technology
                        </h2>

                        <div class="sidebar-accordion">
                            <div class="sidebar-accordion-item">
                                <button class="sidebar-accordion-toggle" aria-expanded="false">
                                    <span class="sidebar-accordion-label">Works</span>
                                    <span class="sidebar-accordion-icon">+</span>
                                </button>
                                <nav class="sidebar-accordion-content">
                                    <% projects.forEach(function(project, index) { %>
                                        <a href="#project-<%= index %>" class="footer-link-item project-link-item">
                                            <%= project.short_title || project.title %>
                                        </a>
                                    <% }); %>
                                    <a href="#more-works" class="footer-link-item">More</a>
                                </nav>
                            </div>
                            <div class="sidebar-accordion-item">
                                <button class="sidebar-accordion-toggle" aria-expanded="false">
                                    <span class="sidebar-accordion-label">Socials</span>
                                    <span class="sidebar-accordion-icon">+</span>
                                </button>
                                <nav class="sidebar-accordion-content">
                                    <% if (theme.social?.twitter) { %>
                                        <a href="<%= theme.social.twitter %>" target="_blank" class="footer-link-item">Twitter</a>
                                    <% } %>
                                    <% if (theme.social?.linkedin) { %>
                                        <a href="<%= theme.social.linkedin %>" target="_blank" class="footer-link-item">LinkedIn</a>
                                    <% } %>
                                    <% if (theme.social?.dribbble) { %>
                                        <a href="<%= theme.social.dribbble %>" target="_blank" class="footer-link-item">Dribbble</a>
                                    <% } %>
                                    <% if (theme.social?.behance) { %>
                                        <a href="<%= theme.social.behance %>" target="_blank" class="footer-link-item">Behance</a>
                                    <% } %>
                                </nav>
                            </div>
                            <div class="sidebar-accordion-item">
                                <a href="#" class="sidebar-accordion-toggle" id="about-toggle">
                                    <span class="sidebar-accordion-label">About</span>
                                </a>
                            </div>
                        </div>

                        <div class="sidebar-cta-wrapper">
                            <a href="#connect" class="unicorn-btn sidebar-btn"
                                data-us-project-src="/button-sidebar.json" data-us-scale="0.6" data-us-dpi="4.0"
                                data-us-production="true">
                                <span class="btn-text">Get in touch</span>
                            </a>
                        </div>
                        <a href="mailto:<%= theme.connect?.email || 'michal@maise.io' %>"
                            class="footer-email-full copy-email-btn">
                            <%= theme.connect?.email || 'michal@maise.io' %>
                        </a>
                    </div>
                </aside>

                <!-- Right Content - Projects -->
                <main class="projects-column" id="projects">

                    <!-- ABOUT VIEW (hidden by default) -->
                    <div class="about-view" id="about-view">
                        <div class="about-back-row">
                            <a href="#" class="project-back" id="about-close">
                                <span class="project-back-icon" aria-hidden="true">&larr;</span>
                                <span class="project-back-label">Back</span>
                            </a>
                        </div>
                        <% if (theme.experience) { %>
                            <section class="about-section">
                                <h2 class="about-title">The Journey</h2>
                                <div class="about-intro" id="about-intro">
                                    <%= theme.experience.intro_variants[0] %>
                                </div>
                                <div class="experience-timeline">
                                    <% theme.experience.timeline.forEach(function(item) { %>
                                        <div class="timeline-item">
                                            <div class="timeline-marker"></div>
                                            <div class="timeline-content">
                                                <div class="timeline-header">
                                                    <span class="timeline-milestone"><%= item.milestone %></span>
                                                    <h4 class="timeline-title"><%= item.title %></h4>
                                                </div>
                                                <p class="timeline-text"><%= item.content %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                <div class="resume-lists-grid">
                                    <% if (theme.speaking) { %>
                                        <div class="resume-list-column">
                                            <h2 class="resume-section-heading">Speaking</h2>
                                            <ul class="resume-list">
                                                <% theme.speaking.forEach(function(item) { %>
                                                    <li class="resume-list-item"
                                                        <% if (item.image) { %>data-preview-image="<%= url_for(item.image) %>"<% } %>
                                                        <% if (item.description) { %>data-preview-description="<%= item.description %>"<% } %>
                                                        data-preview-title="<%= item.title %>"
                                                        data-preview-year="<%= item.year %>">
                                                        <span class="resume-item-title"><%= item.title %></span>
                                                        <span class="resume-item-year"><%= item.year %></span>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% } %>
                                    <% if (theme.events) { %>
                                        <div class="resume-list-column">
                                            <h2 class="resume-section-heading">Events</h2>
                                            <ul class="resume-list">
                                                <% theme.events.forEach(function(item) { %>
                                                    <li
                                                        <% if (item.image) { %>data-preview-image="<%= url_for(item.image) %>"<% } %>
                                                        <% if (item.description) { %>data-preview-description="<%= item.description %>"<% } %>
                                                        data-preview-title="<%= item.title %>"
                                                        data-preview-year="<%= item.year %>">
                                                        <span class="resume-item-title"><%= item.title %></span>
                                                        <span class="resume-item-year"><%= item.year %></span>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="resume-hover-preview">
                                    <div class="preview-content">
                                        <div class="preview-media">
                                            <img src="" alt="" class="preview-image">
                                        </div>
                                        <div class="preview-text">
                                            <div class="preview-header">
                                                <span class="preview-year"></span>
                                                <h4 class="preview-title"></h4>
                                            </div>
                                            <p class="preview-description"></p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        <% } %>
                    </div>

                    <!-- Main content (projects + more works + connect) -->
                    <div class="projects-main-content" id="projects-main-content">
                    <% projects.forEach(function(project, pindex) { %>
                        <% const carouselStyle=[ project.carousel_aspect_ratio ?
                            `\--carousel-aspect-ratio:${project.carousel_aspect_ratio};` : '' ,
                            project.carousel_object_fit ? `\--carousel-object-fit:${project.carousel_object_fit};` : ''
                            , project.carousel_object_position ?
                            `\--carousel-object-position:${project.carousel_object_position};` : '' ,
                            project.carousel_image_scale ? `\--carousel-image-scale:${project.carousel_image_scale};`
                            : '' , project.carousel_image_height ?
                            `\--carousel-image-height:${project.carousel_image_height};` : '' ,
                            project.carousel_image_top ? `\--carousel-image_top:${project.carousel_image_top};` : '' ,
                            ].join(''); %>
                            <section class="project-section reveal-on-scroll" id="project-<%= pindex %>"
                                data-project-index="<%= pindex %>" <% if (carouselStyle) { %>
                                style="<%- carouselStyle %>"<% } %>>
                                        <div class="project-carousel-wrapper" <% if (project.disable_parallax) { %>
                                            data-disable-parallax="true" <% } %>>
                                                <!-- Navigation Zones -->
                                                <div class="carousel-nav-zone carousel-nav-zone--left" data-nav="prev">
                                                </div>
                                                <div class="carousel-nav-zone carousel-nav-zone--right" data-nav="next">
                                                </div>

                                                <div class="embla">
                                                    <div class="embla__viewport">
                                                        <div class="embla__container">
                                                            <% if (project.carousel && project.carousel.length) { %>
                                                                <% project.carousel.forEach(function(imgUrl, slideIndex)
                                                                    { %>
                                                                    <% const
                                                                        firstStyle=(project.carousel_first_object_position
                                                                        && slideIndex===0) ?
                                                                        `style="\--carousel-object-position:${project.carousel_first_object_position};"
                                                                        ` : '' ; %>
                                                                        <div class="embla__slide" <%=firstStyle %>>
                                                                            <div class="project-slide-item">
                                                                                <% const isObject=typeof
                                                                                    imgUrl==='object' && imgUrl !==null;
                                                                                    const lightItem=isObject ?
                                                                                    imgUrl.light : imgUrl; const
                                                                                    darkItem=isObject ? imgUrl.dark :
                                                                                    null; const isJson=(lightItem &&
                                                                                    lightItem.endsWith('.json')); %>
                                                                                    <% if (isJson) { %>
                                                                                        <div class="unicorn-scene"
                                                                                            data-us-project-src="<%- url_for(lightItem) %>"
                                                                                            data-us-scale="1"
                                                                                            data-us-dpi="1.5"
                                                                                            data-us-lazyload="<%= pindex === 0 ? 'false' : 'true' %>"
                                                                                            <%=pindex> 0 ?
                                                                                            'data-background-lazy-us="true"'
                                                                                            : '' %>
                                                                                            data-us-production="true">
                                                                                            <div
                                                                                                class="unicorn-scene-skeleton">
                                                                                            </div>
                                                                                        </div>
                                                                                        <% } else { %>
                                                                                            <div
                                                                                                class="image-container">
                                                                                                <div
                                                                                                    class="image-skeleton">
                                                                                                </div>
                                                                                                <% if (project.blur) {
                                                                                                    %>
                                                                                                    <div class="image-placeholder"
                                                                                                        style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                                    </div>
                                                                                                    <% } %>
                                                                                                        <% if (darkItem)
                                                                                                            { %>
                                                                                                            <img src="<%- url_for(lightItem) %>"
                                                                                                                alt="<%= project.title %>"
                                                                                                                class="theme-light-only"
                                                                                                                loading="<%= pindex === 0 ? 'eager' : 'lazy' %>"
                                                                                                                <%=pindex===0
                                                                                                                ? 'fetchpriority="high"'
                                                                                                                : '' %>
                                                                                                            draggable="false"
                                                                                                            onload="this.parentElement.classList.add('loaded')">
                                                                                                            <img src="<%- url_for(darkItem) %>"
                                                                                                                alt="<%= project.title %>"
                                                                                                                class="theme-dark-only"
                                                                                                                loading="<%= pindex === 0 ? 'eager' : 'lazy' %>"
                                                                                                                <%=pindex===0
                                                                                                                ? 'fetchpriority="high"'
                                                                                                                : '' %>
                                                                                                            draggable="false"
                                                                                                            onload="this.parentElement.classList.add('loaded')">
                                                                                                            <% } else {
                                                                                                                %>
                                                                                                                <img src="<%- url_for(lightItem) %>"
                                                                                                                    alt="<%= project.title %>"
                                                                                                                    loading="<%= pindex === 0 ? 'eager' : 'lazy' %>"
                                                                                                                    <%=pindex===0
                                                                                                                    ? 'fetchpriority="high"'
                                                                                                                    : ''
                                                                                                                    %>
                                                                                                                draggable="false"
                                                                                                                onload="this.parentElement.classList.add('loaded')">
                                                                                                                <% } %>
                                                                                            </div>
                                                                                            <% } %>
                                                                            </div>
                                                                        </div>
                                                                        <% }); %>
                                                                            <% } else if (project.cover) { %>
                                                                                <div class="embla__slide">
                                                                                    <div class="project-slide-item">
                                                                                        <div class="image-container">
                                                                                            <div class="image-skeleton">
                                                                                            </div>
                                                                                            <% if (project.blur) { %>
                                                                                                <div class="image-placeholder"
                                                                                                    style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                                </div>
                                                                                                <% } %>
                                                                                                    <img src="<%- url_for(project.cover) %>"
                                                                                                        alt="<%= project.title %>"
                                                                                                        loading="lazy"
                                                                                                        draggable="false"
                                                                                                        onload="this.parentElement.classList.add('loaded')">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <span class="carousel-scroll-hint" aria-hidden="true">Scroll ↔</span>
                                        </div>
                                        <div class="project-carousel-progress" aria-hidden="true"><span></span></div>

                                        <div class="project-info">
                                            <div class="project-info-header">
                                                <div class="project-text-container">
                                                    <div class="project-title-row">
                                                        <h3 class="project-title">
                                                            <% if (project.website) { %>
                                                                <a href="<%= project.website %>" target="_blank"
                                                                    class="project-title-link">
                                                                    <%= project.title %>
                                                                        <svg class="world-icon" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <circle cx="12" cy="12" r="10"></circle>
                                                                            <line x1="2" y1="12" x2="22" y2="12"></line>
                                                                            <path
                                                                                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                                                                            </path>
                                                                        </svg>
                                                                </a>
                                                                <% } else { %>
                                                                    <%= project.title %>
                                                                        <% } %>
                                                        </h3>
                                                    </div>
                                                    <% if (project.intro) { %>
                                                        <p class="project-subtitle">
                                                            <%= project.intro %>
                                                        </p>
                                                        <% } %>
                                                </div>
                                                <div class="project-actions">
                                                    <a href="<%- url_for(project.path) %>" class="project-pill-button">
                                                        <span>Details</span>
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2.5" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                                            <polyline points="7 7 17 7 17 17"></polyline>
                                                        </svg>
                                                    </a>
                                                </div>
                                            </div>
                                            <% if (project.description) { %>
                                                <div class="project-description">
                                                    <p class="project-info-text">
                                                        <%= project.description %>
                                                    </p>
                                                </div>
                                                <% } else if (project.problem || project.solution) { %>
                                                    <div class="project-description">
                                                        <p class="project-info-text">
                                                            <%= project.problem %>
                                                                <%= project.solution %>
                                                        </p>
                                                    </div>
                                                    <% } %>
                                                        <div class="project-meta-row">
                                                            <% if (project.scope && project.scope.length) { %>
                                                                <div class="project-scope-tags">
                                                                    <% project.scope.forEach(function(item, idx) { %>
                                                                        <span class="scope-tag">
                                                                            <%= item %>
                                                                        </span>
                                                                        <% if (idx < project.scope.length - 1) { %><span
                                                                                class="scope-separator">·</span>
                                                                            <% } %>
                                                                                <% }); %>
                                                                </div>
                                                                <% } %>
                                                                    <span class="project-year">
                                                                        <%= project.when || project.date_label ||
                                                                            project.year || '—' %>
                                                                    </span>
                                                        </div>
                                        </div>
                            </section>
                            <% }); %>

                                <!-- MORE WORK AREA -->
                                <div id="more-works">
                                    <!-- MORE WORK SECTION (BEHANCE) -->
                                    <section class="more-work-section reveal-on-scroll" id="more-works-behance">
                                        <div class="more-work-grid">
                                            <a href="https://www.behance.net/samborek" target="_blank"
                                                class="work-tile intro-tile">
                                                <div class="intro-arrow-wrapper">
                                                    <span class="intro-arrow">↗</span>
                                                </div>
                                                <div class="intro-content">
                                                    <h2 class="intro-title">See more of my work</h2>
                                                    <span class="intro-subtitle">Behance</span>
                                                </div>
                                            </a>
                                            <a href="https://www.behance.net/gallery/78992065/CakeWallet-First-Open-Source-Monero-Wallet"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/behance/cakewallet.png') %>"
                                                        alt="Cake Wallet" loading="lazy">
                                                </div>
                                            </a>
                                            <a href="https://www.behance.net/gallery/90433865/DesignWays-Conf-Designs"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/behance/dwc.png') %>" alt="DWC"
                                                        loading="lazy">
                                                </div>
                                            </a>
                                            <a href="https://www.behance.net/gallery/62252031/PRO-Voice-Site-Design-Product-Design"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/behance/Editing%20PRO%20Voice%20Site%20Design.png') %>"
                                                        alt="Editing Pro Voice" loading="lazy">
                                                </div>
                                            </a>
                                        </div>
                                    </section>

                                    <!-- MORE WORK SECTION (DRIBBBLE) -->
                                    <section class="more-work-section reveal-on-scroll" id="more-works-dribbble"
                                        style="margin-top: var(--section-gap);">
                                        <div class="more-work-grid">
                                            <a href="https://dribbble.com/samborek" target="_blank"
                                                class="work-tile intro-tile">
                                                <div class="intro-arrow-wrapper">
                                                    <span class="intro-arrow">↗</span>
                                                </div>
                                                <div class="intro-content">
                                                    <h2 class="intro-title">Explore last shots</h2>
                                                    <span class="intro-subtitle">Dribbble</span>
                                                </div>
                                            </a>
                                            <a href="https://dribbble.com/shots/21192557-3D-Telegram-Icon"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/dribbble/telegram_icon.png') %>"
                                                        alt="3D Telegram Icon" loading="lazy">
                                                </div>
                                            </a>
                                            <a href="https://dribbble.com/shots/17787996-Raincards-Landing-Page"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/dribbble/raincards.png') %>"
                                                        alt="Raincards" loading="lazy">
                                                </div>
                                            </a>
                                            <a href="https://dribbble.com/shots/15762676-VUI-Investment-Wallet"
                                                target="_blank" class="work-tile">
                                                <div class="tile-image-wrapper">
                                                    <img src="<%- url_for('/images/work/dribbble/vui_wallet.png') %>"
                                                        alt="VUI Wallat" loading="lazy">
                                                </div>
                                            </a>
                                        </div>
                                    </section>
                                </div>


                                        <!-- CONNECT SECTION -->
                                        <% if (theme.connect) { %>
                                            <section class="content-section reveal-on-scroll" id="connect">
                                                <div class="connect-wrapper">
                                                    <h2 class="project-title">
                                                        <%= theme.connect.title %>
                                                    </h2>
                                                    <div class="connect-content">
                                                        <div class="connect-main">
                                                            <p class="project-info-text section-intro">
                                                                <%= theme.connect.intro %>
                                                            </p>
                                                            <a href="<%= theme.connect.cta.link %>" class="unicorn-btn"
                                                                data-us-project-src="/button.json" data-us-scale="1"
                                                                data-us-dpi="1.5" data-us-production="true"
                                                                target="_blank" rel="noopener">
                                                                <span class="btn-text">
                                                                    <%= theme.connect.cta.text %>
                                                                </span>
                                                            </a>
                                                        </div>
                                                        <div class="connect-side">
                                                            <div class="connect-secondary">
                                                                <p class="project-info-text">
                                                                    <%= theme.connect.secondary_text %>
                                                                </p>
                                                                <a href="#" class="connect-link" id="collab-toggle">
                                                                    Learn how we can collaborate →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Collaboration Section (expandable) -->
                                                    <%
                                                        const coopPage = site.pages.toArray().filter(p => p.source === 'work/cooperation.md')[0];
                                                        let coopRaw = (coopPage && coopPage.raw) ? coopPage.raw : '';
                                                        // Strip front matter
                                                        coopRaw = coopRaw.replace(/^---[\s\S]*?---\s*/, '');
                                                        const coopLines = coopRaw.trim().split('\n');

                                                        // Parse: heading, intro paragraphs, sections (h3), items (bold title — *price* + description)
                                                        let coopTitle = '';
                                                        let coopIntro = [];
                                                        let coopSections = [];
                                                        let currentSection = null;

                                                        coopLines.forEach(line => {
                                                            const l = line.trim();
                                                            if (!l) return;
                                                            if (l.startsWith('# ')) {
                                                                coopTitle = l.replace('# ', '');
                                                            } else if (l.startsWith('### ')) {
                                                                currentSection = { title: l.replace('### ', ''), items: [] };
                                                                coopSections.push(currentSection);
                                                            } else if (l.startsWith('**') && currentSection) {
                                                                // Parse: **Title** — *price*  OR  **Title**
                                                                const titleMatch = l.match(/^\*\*(.+?)\*\*(?:\s*—\s*\*(.+?)\*)?$/);
                                                                if (titleMatch) {
                                                                    currentSection.items.push({
                                                                        title: titleMatch[1],
                                                                        price: titleMatch[2] || '',
                                                                        desc: ''
                                                                    });
                                                                }
                                                            } else if (currentSection && currentSection.items.length > 0) {
                                                                const lastItem = currentSection.items[currentSection.items.length - 1];
                                                                lastItem.desc += (lastItem.desc ? ' ' : '') + l;
                                                            } else if (!currentSection) {
                                                                coopIntro.push(l);
                                                            }
                                                        });
                                                    %>
                                                    <div class="collab-section" id="collab-section">
                                                        <div class="collab-inner">
                                                            <div class="collab-header">
                                                                <h3 class="collab-heading"><%= coopTitle %></h3>
                                                                <a href="#" class="collab-close" id="collab-close">
                                                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                                                                        <line x1="1" y1="1" x2="13" y2="13"></line>
                                                                        <line x1="13" y1="1" x2="1" y2="13"></line>
                                                                    </svg>
                                                                    Close
                                                                </a>
                                                            </div>
                                                            <% if (coopIntro.length) { %>
                                                                <p class="collab-text"><%= coopIntro.join(' ') %></p>
                                                            <% } %>
                                                            <% coopSections.forEach(section => { %>
                                                                <h4 class="collab-subheading"><%= section.title %></h4>
                                                                <div class="collab-cards">
                                                                    <% section.items.forEach(item => { %>
                                                                        <div class="collab-card">
                                                                            <strong><%= item.title %></strong>
                                                                            <% if (item.price) { %>
                                                                                <span class="collab-price"><%= item.price %></span>
                                                                            <% } %>
                                                                            <span><%= item.desc %></span>
                                                                        </div>
                                                                    <% }); %>
                                                                </div>
                                                            <% }); %>
                                                        </div>
                                                    </div>
                                                    <div class="connect-footer-bottom">
