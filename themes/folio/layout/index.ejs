<script>
    document.addEventListener('DOMContentLoaded', function () {
        const viewport = document.getElementById('app-viewport');
        const homeView = document.getElementById('home-view');
        const playgroundView = document.getElementById('playground-view');
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabIndicator = document.querySelector('.tab-indicator');
        const floatControls = document.querySelector('.floating-controls');
        const isMobile = () => window.innerWidth <= 768;

        // --- About View Toggle ---
        const aboutToggle = document.getElementById('about-toggle');
        const aboutClose = document.getElementById('about-close');
        const aboutView = document.getElementById('about-view');
        const mainContent = document.getElementById('projects-main-content');

        function showAbout(e) {
            e.preventDefault();
            mainContent.classList.add('is-hidden');
            aboutView.classList.add('is-active');
            homeView.scrollTop = 0;
            document.getElementById('projects').scrollTop = 0;
        }
        function hideAbout(e) {
            e.preventDefault();
            aboutView.classList.remove('is-active');
            mainContent.classList.remove('is-hidden');
        }
        if (aboutToggle) aboutToggle.addEventListener('click', showAbout);
        if (aboutClose) aboutClose.addEventListener('click', hideAbout);

        // Close About when clicking any sidebar project/section link
        document.querySelectorAll('.sidebar-accordion-content .footer-link-item').forEach(link => {
            link.addEventListener('click', () => {
                if (aboutView.classList.contains('is-active')) {
                    aboutView.classList.remove('is-active');
                    mainContent.classList.remove('is-hidden');
                }
            });
        });

        // --- Collaboration Toggle ---
        const collabToggle = document.getElementById('collab-toggle');
        const collabClose = document.getElementById('collab-close');
        const collabSection = document.getElementById('collab-section');
        function toggleCollab(e) {
            e.preventDefault();
            const isOpen = collabSection.classList.toggle('is-open');
            if (isOpen) {
                setTimeout(() => {
                    collabSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }
        }
        if (collabToggle && collabSection) {
            collabToggle.addEventListener('click', toggleCollab);
        }
        if (collabClose && collabSection) {
            collabClose.addEventListener('click', toggleCollab);
        }

        // --- View & Scroll Management ---
        let activeView = homeView;
        let scrollListeners = new Map();

        // Register hover handler for controls
        floatControls.addEventListener('mouseenter', () => {
            floatControls.classList.remove('controls-hidden');
            const handler = scrollListeners.get(activeView);
            if (handler) {
                clearTimeout(handler.timer);
            }
        });

        // Scroll handler factory
        const createScrollHandler = (viewElement) => {
            let lastScrollY = 0;
            const threshold = 10; // Minimum scroll distance to trigger a change

            const handler = () => {
                const currentScrollY = viewElement.scrollTop;
                const scrollDiff = Math.abs(currentScrollY - lastScrollY);

                if (scrollDiff < threshold) return;

                // If scrolling down, hide
                if (currentScrollY > lastScrollY && currentScrollY > 100) {
                    floatControls.classList.add('controls-hidden');
                } else if (currentScrollY < lastScrollY) {
                    // If scrolling up, show
                    floatControls.classList.remove('controls-hidden');
                }

                // If at the very top, always show
                if (currentScrollY <= 10) {
                    floatControls.classList.remove('controls-hidden');
                }

                lastScrollY = currentScrollY;

                // Show after scrolling stops
                clearTimeout(handler.timer);
                handler.timer = setTimeout(() => {
                    floatControls.classList.remove('controls-hidden');
                }, 1200); // Wait longer before auto-showing
            };
            handler.timer = null;
            return handler;
        };

        // Initialize scroll handlers for both views
        [homeView, playgroundView].forEach(view => {
            const handler = createScrollHandler(view);
            scrollListeners.set(view, handler);
            // Verify: Should we listen on 'scroll' for both? Yes.
            // But we only want the active one to affect the controls? 
            // Or both? For now, let's attach to both but maybe only active matters?
            // Simpler: attach to both. If you scroll the hidden one (inactive), 
            // it might hide controls which is weird but rare (momentum).
            // Let's attach actively when switching.
        });

        const attachScrollListener = (view) => {
            [homeView, playgroundView].forEach(v => {
                const h = scrollListeners.get(v);
                v.removeEventListener('scroll', h);
            });
            const handler = scrollListeners.get(view);
            view.addEventListener('scroll', handler, { passive: true });
        };

        // Start with Home
        attachScrollListener(homeView);

        // --- Navigation Logic ---
        const updateIndicator = (activeBtn) => {
            if (!tabIndicator || !activeBtn) return;
            const rect = activeBtn.getBoundingClientRect();
            const parentRect = activeBtn.parentElement.getBoundingClientRect();
            tabIndicator.style.width = `${rect.width}px`;
            tabIndicator.style.transform = `translateX(${rect.left - parentRect.left}px)`;
        };

        // Initial indicator
        const initialActive = document.querySelector('.tab-button.active');
        if (initialActive) {
            document.fonts.ready.then(() => {
                setTimeout(() => updateIndicator(initialActive), 100);
            });
        }

        // Initialize aria-hidden
        homeView.setAttribute('aria-hidden', 'false');
        playgroundView.setAttribute('aria-hidden', 'true');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const tab = button.dataset.tab;
                const currentActiveBtn = document.querySelector('.tab-button.active');
                if (currentActiveBtn === button) return;

                // Update Buttons
                tabButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                updateIndicator(button);

                // Slide Viewport & Manage Visibility
                if (tab === 'playground') {
                    viewport.style.transform = 'translateX(-50%)';
                    activeView = playgroundView;
                    playgroundView.setAttribute('aria-hidden', 'false');
                    homeView.setAttribute('aria-hidden', 'true');

                    // Wake up playground
                    setTimeout(() => {
                        window.dispatchEvent(new Event('resize'));
                        // Trigger mousemove to wake unicorn
                        window.dispatchEvent(new MouseEvent('mousemove', {
                            clientX: window.innerWidth / 2,
                            clientY: window.innerHeight / 2,
                            bubbles: true
                        }));
                    }, 750); // > 0.7s transition
                } else {
                    viewport.style.transform = 'translateX(0)';
                    activeView = homeView;
                    homeView.setAttribute('aria-hidden', 'false');
                    playgroundView.setAttribute('aria-hidden', 'true');
                }

                // Update Scroll Listener
                attachScrollListener(activeView);
                // Ensure controls are visible when switching
                floatControls.classList.remove('controls-hidden');
            });
        });

        window.addEventListener('resize', () => {
            const btn = document.querySelector('.tab-button.active');
            if (btn) updateIndicator(btn);
        });


        // --- Video Lazy Loading (Playground) ---
        const loadVideo = (item) => {
            const video = item.querySelector('video');
            const src = item.dataset.videoSrc;
            if (video && !video.src) {
                video.src = src;
                video.load();
                const checkLoaded = () => {
                    if (video.readyState >= 2) {
                        video.classList.add('loaded');
                        video.removeEventListener('loadeddata', checkLoaded);
                    }
                };
                if (video.readyState >= 2) checkLoaded();
                else video.addEventListener('loadeddata', checkLoaded);
            }
        };

        const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) loadVideo(entry.target);
            });
        }, { root: playgroundView, rootMargin: '200px', threshold: 0.01 }); // Root is now playgroundView? Or null? relative to viewport yes.

        // Mobile Focus
        const mobileFocusObserver = new IntersectionObserver((entries) => {
            if (!isMobile()) return;
            entries.forEach(entry => {
                const video = entry.target.querySelector('video');
                if (video) {
                    if (entry.isIntersecting) video.play().catch(() => { });
                    else {
                        video.pause();
                        video.currentTime = 0;
                    }
                }
            });
        }, { root: playgroundView, threshold: 0.7 });

        const videoItems = document.querySelectorAll('.playground-item');
        videoItems.forEach(item => {
            videoObserver.observe(item);
            mobileFocusObserver.observe(item);

            item.addEventListener('mouseenter', () => {
                if (isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    if (video.readyState >= 2) video.play().catch(() => { });
                    else {
                        loadVideo(item);
                        video.addEventListener('loadeddata', () => {
                            video.play().catch(() => { });
                        }, { once: true });
                    }
                }
            });
            item.addEventListener('mouseleave', () => {
                if (isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    video.pause();
                    video.currentTime = 0;
                }
            });
            item.addEventListener('click', () => {
                if (!isMobile()) return;
                const video = item.querySelector('video');
                if (video) {
                    if (video.paused) video.play().catch(() => { });
                    else video.pause();
                }
            });
        });
    });
</script>