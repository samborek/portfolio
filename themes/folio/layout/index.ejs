                                                    curGroup = { title: s.replace('#### ', ''), items: [] };
                                                    scopeGroups.push(curGroup);
                                                } else if (foundScope && s.startsWith('- ') && curGroup) {
                                                    curGroup.items.push(s.replace('- ', ''));
                                                } else if (foundScope && !curGroup) {
                                                    scopeIntro = s;
