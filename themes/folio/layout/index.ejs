<div class="gradient-blobs">
    <div class="blob-violet"></div>
</div>

<div id="app-viewport">
    <!-- VIEW 1: HOME (Sidebar + Work) -->
    <div id="home-view" class="app-view">
        <div class="portfolio-wrapper">
            <% const projects=site.pages.filter(p=> p.layout === 'project').toArray().sort((a, b) => (b.order || 0) -
                (a.order || 0)); %>

                <!-- Left Sidebar -->
                <aside class="sidebar">
                    <div class="sidebar-content">
                        <div class="sidebar-hero">
                            <span class="project-link-item"
                                style="text-transform: lowercase; border-bottom: none;">Michal Sambora — sambø</span>
                        </div>
                        <h1 class="sidebar-title">
                            <%= theme.hero_title || "I'm  Michal Sambora" %>
                        </h1>

                        <!-- Work Links (Collapsible) -->
                        <div class="project-links">
                            <button class="project-links-toggle" aria-expanded="false" aria-controls="work-list">
                                <span class="project-links-label">Selected Work</span>
                                <span class="toggle-arrow">↓</span>
                            </button>
                            <div class="project-links-list collapsed" id="work-list">
                                <% projects.forEach(function(project, index) { %>
                                    <a href="#project-<%= index %>" class="project-link-item">
                                        <%= project.title %>
                                    </a>
                                    <% }); %>
                            </div>
                        </div>

                        <hr class="sidebar-separator">

                        <!-- Navigation Links -->
                        <div class="nav-links">
                            <% if (theme.experience) { %>
                                <a href="#experience" class="project-link-item">Experience</a>
                                <% } %>
                                    <a href="#connect" class="project-link-item">Let's connect</a>
                        </div>
                    </div>

                    <div class="sidebar-footer">
                        <div class="social-icons">
                            <% if (theme.social?.twitter) { %><a href="<%= theme.social.twitter %>"
                                    target="_blank">𝕏</a>
                                <% } %>
                                    <% if (theme.social?.linkedin) { %><a href="<%= theme.social.linkedin %>"
                                            target="_blank">in</a>
                                        <% } %>
                                            <% if (theme.social?.dribbble) { %><a href="<%= theme.social.dribbble %>"
                                                    target="_blank">◉</a>
                                                <% } %>
                                                    <% if (theme.social?.behance) { %><a
                                                            href="<%= theme.social.behance %>" target="_blank">Bē</a>
                                                        <% } %>
                                                            <% if (theme.social?.gumroad) { %><a
                                                                    href="<%= theme.social.gumroad %>"
                                                                    target="_blank">G</a>
                                                                <% } %>
                        </div>

                        <div class="sidebar-contact">
                            <a href="mailto:michal@maise.io" class="sidebar-email">michal@maise.io</a>
                        </div>
                    </div>
                </aside>

                <!-- Right Content - Projects -->
                <main class="projects-column" id="projects">
                    <% projects.forEach(function(project, pindex) { %>
                        <% const carouselStyle=[ project.carousel_aspect_ratio ?
                            `\--carousel-aspect-ratio:${project.carousel_aspect_ratio};` : '' ,
                            project.carousel_object_fit ? `\--carousel-object-fit:${project.carousel_object_fit};` : ''
                            , project.carousel_object_position ?
                            `\--carousel-object-position:${project.carousel_object_position};` : '' ,
                            project.carousel_image_scale ? `\--carousel-image-scale:${project.carousel_image_scale};`
                            : '' , project.carousel_image_height ?
                            `\--carousel-image-height:${project.carousel_image_height};` : '' ,
                            project.carousel_image_top ? `\--carousel-image_top:${project.carousel_image_top};` : '' ,
                            ].join(''); %>
                            <section class="project-section" id="project-<%= pindex %>"
                                data-project-index="<%= pindex %>" <% if (carouselStyle) { %> style="<%- carouselStyle
                                    %>"<% } %>>
                                        <div class="project-carousel-wrapper" <% if (project.disable_parallax) { %>
                                            data-disable-parallax="true" <% } %>>
                                                <!-- Navigation Zones -->
                                                <div class="carousel-nav-zone carousel-nav-zone--left" data-nav="prev">
                                                </div>
                                                <div class="carousel-nav-zone carousel-nav-zone--right" data-nav="next">
                                                </div>

                                                <div class="embla">
                                                    <div class="embla__viewport">
                                                        <div class="embla__container">
                                                            <% if (project.carousel && project.carousel.length) { %>
                                                                <% project.carousel.forEach(function(imgUrl, slideIndex)
                                                                    { %>
                                                                    <% const
                                                                        firstStyle=(project.carousel_first_object_position
                                                                        && slideIndex===0) ?
                                                                        `style="\--carousel-object-position:${project.carousel_first_object_position};"
                                                                        ` : '' ; %>
                                                                        <div class="embla__slide" <%=firstStyle %>>
                                                                            <div class="project-slide-item">
                                                                                <% if (imgUrl.endsWith('.json')) { %>
                                                                                    <div class="unicorn-scene"
                                                                                        data-us-project-src="<%- url_for(imgUrl) %>"
                                                                                        data-us-scale="1"
                                                                                        data-us-dpi="1.5"
                                                                                        data-us-lazyload="<%= pindex === 0 ? 'false' : 'true' %>"
                                                                                        <%=pindex> 0 ?
                                                                                        'data-background-lazy-us="true"'
                                                                                        : '' %>
                                                                                        data-us-production="true">
                                                                                        <div
                                                                                            class="unicorn-scene-skeleton">
                                                                                        </div>
                                                                                    </div>
                                                                                    <% } else { %>
                                                                                        <div class="image-container">
                                                                                            <div class="image-skeleton">
                                                                                            </div>
                                                                                            <% if (project.blur) { %>
                                                                                                <div class="image-placeholder"
                                                                                                    style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                                </div>
                                                                                                <% } %>
                                                                                                    <img src="<%- url_for(imgUrl) %>"
                                                                                                        alt="<%= project.title %>"
                                                                                                        loading="<%= pindex === 0 ? 'eager' : 'lazy' %>"
                                                                                                        <%=pindex===0
                                                                                                        ? 'fetchpriority="high"'
                                                                                                        : '' %>
                                                                                                    draggable="false"
                                                                                                    onload="this.parentElement.classList.add('loaded')">
                                                                                        </div>
                                                                                        <% } %>
                                                                            </div>
                                                                        </div>
                                                                        <% }); %>
                                                                            <% } else if (project.cover) { %>
                                                                                <div class="embla__slide">
                                                                                    <div class="project-slide-item">
                                                                                        <div class="image-container">
                                                                                            <div class="image-skeleton">
                                                                                            </div>
                                                                                            <% if (project.blur) { %>
                                                                                                <div class="image-placeholder"
                                                                                                    style="background-image: url('<%- url_for(project.blur) %>');">
                                                                                                </div>
                                                                                                <% } %>
                                                                                                    <img src="<%- url_for(project.cover) %>"
                                                                                                        alt="<%= project.title %>"
                                                                                                        loading="lazy"
                                                                                                        draggable="false"
                                                                                                        onload="this.parentElement.classList.add('loaded')">
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <span class="carousel-scroll-hint" aria-hidden="true">Scroll ↔</span>
                                        </div>
                                        <div class="project-carousel-progress" aria-hidden="true"><span></span></div>

                                        <div class="project-info">
                                            <div class="project-info-header">
                                                <div class="project-text-container">
                                                    <div class="project-title-row">
                                                        <h3 class="project-title">
                                                            <% if (project.website) { %>
                                                                <a href="<%= project.website %>" target="_blank"
                                                                    class="project-title-link">
                                                                    <%= project.title %>
                                                                        <svg class="world-icon" viewBox="0 0 24 24"
                                                                            fill="none" stroke="currentColor"
                                                                            stroke-width="2" stroke-linecap="round"
                                                                            stroke-linejoin="round">
                                                                            <circle cx="12" cy="12" r="10"></circle>
                                                                            <line x1="2" y1="12" x2="22" y2="12"></line>
                                                                            <path
                                                                                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                                                                            </path>
                                                                        </svg>
                                                                </a>
                                                                <% } else { %>
                                                                    <%= project.title %>
                                                                        <% } %>
                                                        </h3>
                                                    </div>
                                                    <% if (project.intro) { %>
                                                        <p class="project-subtitle">
                                                            <%= project.intro %>
                                                        </p>
                                                        <% } %>
                                                </div>
                                                <div class="project-actions">
                                                    <a href="<%- url_for(project.path) %>" class="project-pill-button">
                                                        <span>View Project</span>
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                            stroke-width="2.5" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                                            <polyline points="7 7 17 7 17 17"></polyline>
                                                        </svg>
                                                    </a>
                                                </div>
                                            </div>
                                            <% if (project.description) { %>
                                                <div class="project-description">
                                                    <p class="project-info-text">
                                                        <%= project.description %>
                                                    </p>
                                                </div>
                                                <% } else if (project.problem || project.solution) { %>
                                                    <div class="project-description">
                                                        <p class="project-info-text">
                                                            <%= project.problem %>
                                                                <%= project.solution %>
                                                        </p>
                                                    </div>
                                                    <% } %>
                                                        <div class="project-meta-row">
                                                            <% if (project.scope && project.scope.length) { %>
                                                                <div class="project-scope-tags">
                                                                    <% project.scope.forEach(function(item, idx) { %>
                                                                        <span class="scope-tag">
                                                                            <%= item %>
                                                                        </span>
                                                                        <% if (idx < project.scope.length - 1) { %><span
                                                                                class="scope-separator">·</span>
                                                                            <% } %>
                                                                                <% }); %>
                                                                </div>
                                                                <% } %>
                                                                    <span class="project-year">
                                                                        <%= project.when || project.date_label ||
                                                                            project.year || '—' %>
                                                                    </span>
                                                        </div>
                                        </div>
                            </section>
                            <% }); %>

                                <!-- EXPERIENCE SECTION -->
                                <% if (theme.experience) { %>
                                    <section class="content-section" id="experience">
                                        <div class="section-header">
                                            <h2 class="project-title">The Journey</h2>
                                        </div>
                                        <div class="experience-intro" id="experience-intro">
                                            <%= theme.experience.intro_variants[0] %>
                                        </div>
                                        <script>(function () { const variants =<% - JSON.stringify(theme.experience.intro_variants) %>; const randomIndex = Math.floor(Math.random() * variants.length); document.getElementById('experience-intro').textContent = variants[randomIndex]; })();</script>
                                        <div class="experience-timeline">
                                            <% theme.experience.timeline.forEach(function(item) { %>
                                                <div class="timeline-item">
                                                    <div class="timeline-marker"></div>
                                                    <div class="timeline-content">
                                                        <div class="timeline-header">
                                                            <span class="timeline-milestone">
                                                                <%= item.milestone %>
                                                            </span>
                                                            <h4 class="timeline-title">
                                                                <%= item.title %>
                                                            </h4>
                                                        </div>
                                                        <p class="timeline-text">
                                                            <%= item.content %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <div class="resume-lists-grid">
                                            <% if (theme.speaking) { %>
                                                <div class="resume-list-column">
                                                    <h2 class="resume-section-heading">Speaking</h2>
                                                    <ul class="resume-list">
                                                        <% theme.speaking.forEach(function(item) { %>
                                                            <li class="resume-list-item" <% if (item.image) { %>
                                                                data-preview-image="<%= url_for(item.image) %>" <% } %>
                                                                        <% if (item.description) { %>
                                                                            data-preview-description="<%=
                                                                                item.description %>" <% } %>
                                                                                    data-preview-title="<%= item.title
                                                                                        %>" data-preview-year="<%=
                                                                                            item.year %>">
                                                                                            <span
                                                                                                class="resume-item-title">
                                                                                                <%= item.title %>
                                                                                            </span>
                                                                                            <span
                                                                                                class="resume-item-year">
                                                                                                <%= item.year %>
                                                                                            </span>
                                                            </li>
                                                            <% }); %>
                                                    </ul>
                                                </div>
                                                <% } %>
                                                    <% if (theme.events) { %>
                                                        <div class="resume-list-column">
                                                            <h2 class="resume-section-heading">Events</h2>
                                                            <ul class="resume-list">
                                                                <% theme.events.forEach(function(item) { %>
                                                                    <li class="resume-list-item" <% if (item.image) { %>
                                                                        data-preview-image="<%= url_for(item.image) %>"
                                                                            <% } %>
                                                                                <% if (item.description) { %>
                                                                                    data-preview-description="<%=
                                                                                        item.description %>" <% } %>
                                                                                            data-preview-title="<%=
                                                                                                item.title %>"
                                                                                                data-preview-year="<%=
                                                                                                    item.year %>">
                                                                                                    <span
                                                                                                        class="resume-item-title">
                                                                                                        <%= item.title
                                                                                                            %>
                                                                                                    </span>
                                                                                                    <span
                                                                                                        class="resume-item-year">
                                                                                                        <%= item.year %>
                                                                                                    </span>
                                                                    </li>
                                                                    <% }); %>
                                                            </ul>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </section>
                                    <% } %>

                                        <!-- CONNECT SECTION -->
                                        <% if (theme.connect) { %>
                                            <section class="content-section" id="connect">
                                                <div class="connect-wrapper">
                                                    <h2 class="project-title">
                                                        <%= theme.connect.title %>
                                                    </h2>
                                                    <div class="connect-content">
                                                        <div class="connect-main">
                                                            <p class="project-info-text section-intro">
                                                                <%= theme.connect.intro %>
                                                            </p>
                                                            <a href="<%= theme.connect.cta.link %>" class="unicorn-btn"
                                                                data-us-project-src="/button.json" data-us-scale="1"
                                                                data-us-dpi="1.5" data-us-production="true"
                                                                target="_blank" rel="noopener">
                                                                <span class="btn-text">
                                                                    <%= theme.connect.cta.text %>
                                                                </span>
                                                            </a>
                                                        </div>
                                                        <div class="connect-side">
                                                            <div class="connect-secondary">
                                                                <p class="project-info-text">
                                                                    <%= theme.connect.secondary_text %>
                                                                </p>
                                                                <a href="<%= theme.connect.guide_link.link %>"
                                                                    class="connect-link">
                                                                    <%= theme.connect.guide_link.text %>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="connect-footer-bottom">
                                                        <a href="mailto:<%= theme.connect.email %>"
                                                            class="connect-footer-email">
                                                            <%= theme.connect.email %>
                                                        </a>
                                                        <div class="connect-footer-socials">
                                                            <% if (theme.social?.twitter) { %><a
                                                                    href="<%= theme.social.twitter %>"
                                                                    target="_blank">Twitter</a>
                                                                <% } %>
                                                                    <% if (theme.social?.linkedin) { %><a
                                                                            href="<%= theme.social.linkedin %>"
                                                                            target="_blank">Linkedin</a>
                                                                        <% } %>
                                                                            <% if (theme.social?.dribbble) { %><a
                                                                                    href="<%= theme.social.dribbble %>"
                                                                                    target="_blank">Dribbble</a>
                                                                                <% } %>
                                                                                    <% if (theme.social?.behance) { %><a
                                                                                            href="<%= theme.social.behance %>"
                                                                                            target="_blank">Behance</a>
                                                                                        <% } %>
                                                                                            <% if
                                                                                                (theme.social?.gumroad)
                                                                                                { %><a
                                                                                                    href="<%= theme.social.gumroad %>"
                                                                                                    target="_blank">Gumroad</a>
                                                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>
                                            <% } %>
                </main>
        </div>
    </div>

    <!-- VIEW 2: PLAYGROUND -->
    <div id="playground-view" class="app-view">
        <div class="playground-wrapper">
            <div class="playground-header">
                <h1 class="playground-title">Playground</h1>
                <p class="playground-description">A collection of experimental work, motion studies, and creative
                    explorations.</p>
            </div>
            <div class="playground-grid">
                <% const playgroundVideos=[ '3TnVVtbRGc81oG7i-spotify6.mp4'
                    , '6luiGS6HomsrGqhP-spline-globe-fin-new.mp4' , '8pjaPeYtdRZiNOnh-twist3.mp4'
                    , 'CooeBgvmvFYvDAoO-telegram.mp4' , 'DkFBhbq1rQM99H24-gameon-foil-render.mp4'
                    , 'EMYd2V3C1F9o9RjP-chair-final4.mp4' , 'LUrt7ghywo6GtBFD-glass-crazy.mp4'
                    , 'NmRHgrXKOmLOiV5g-fons-test-final4.mp4' , 'QgXyYGOsO8VgS1lz-kubi.mp4'
                    , 'S1YWUlCGLZu4o183-notion-3-d.mp4' , 'TxmuoDsqqh0dn2G9-eau-du-splinette-final.mp4'
