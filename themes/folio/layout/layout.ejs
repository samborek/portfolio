<!DOCTYPE html>
<html lang="<%= config.language %>">

<head>
    <meta charset="UTF-8">
    <%
        const siteUrl = (config.url || '').replace(/\/$/, '');
        const pageTitle = page.meta_title || (
            page.layout === 'project' && page.title
                ? page.title + (page.category ? ' ' + page.category : '') + ' Product Design Case Study'
                : page.title
        );
        const metaTitle = pageTitle ? pageTitle + ' // ' + config.title : config.title;
        const metaDescription = page.meta_description || page.description || page.solution || page.problem || page.intro || config.description;
        const metaKeywords = page.keywords || config.keywords;
        const metaImagePath = page.og_image || page.cover || page.hero_image || '/images/work/hydration_1.jpg';
        const metaImage = /^https?:\/\//.test(metaImagePath) ? metaImagePath : siteUrl + url_for(metaImagePath);
        const canonicalPath = page.path === 'index.html' ? '/' : url_for(page.path || '');
        const canonicalUrl = siteUrl + canonicalPath;
        const isHomePage = page.path === 'index.html';
        const jsonLdGraph = [
            {
                '@type': 'Person',
                '@id': siteUrl + '/#person',
                name: 'Michal Sambora',
                alternateName: ['SAMBO', 'SAMBOREK', 'sambø'],
                jobTitle: 'Senior Product Designer',
                description: 'Senior product designer, UI/UX designer, startup design partner, and AI-assisted design engineering collaborator based in Poland, working from Krakow on digital products, design systems, fintech, crypto, Web3, SaaS, mobile apps, web apps, and prototypes.',
                url: siteUrl + '/',
                email: theme.email || theme.connect?.email || 'contact@msambora.com',
                address: {
                    '@type': 'PostalAddress',
                    addressLocality: 'Krakow',
                    addressRegion: 'Malopolskie',
                    addressCountry: 'PL'
                },
                sameAs: [
                    theme.social?.linkedin,
                    theme.social?.dribbble,
                    theme.social?.behance,
                    theme.social?.twitter
                ].filter(Boolean),
                knowsAbout: [
                    'Product design',
                    'UI/UX design',
                    'Startup product design',
                    'Startup design partner',
                    'AI-assisted product design',
                    'AI prototyping',
                    'Design engineering',
                    'Design-to-code workflows',
                    'Design systems',
                    'Figma prototyping',
                    'Mobile app design',
                    'Web app design',
                    'SaaS product design',
                    'Fintech design',
                    'Crypto and Web3 design',
                    'DeFi UX',
                    'Design tokens',
                    'Development handoff'
                ],
                areaServed: [
                    { '@type': 'Country', name: 'Poland' },
                    { '@type': 'City', name: 'Krakow' },
                    { '@type': 'City', name: 'Kraków' },
                    { '@type': 'AdministrativeArea', name: 'Europe' }
                ]
            },
            {
                '@type': 'WebSite',
                '@id': siteUrl + '/#website',
                name: 'Michal Sambora Portfolio',
                alternateName: ['SAMBO', 'SAMBOREK', 'sambø'],
                url: siteUrl + '/',
                publisher: { '@id': siteUrl + '/#person' },
                inLanguage: 'en'
            }
        ];
        if (isHomePage) {
            jsonLdGraph.push({
                '@type': 'ProfessionalService',
                '@id': siteUrl + '/#product-design-service',
                name: 'Michal Sambora Product Design',
                description: 'Senior product design, UI/UX, design systems, AI-assisted prototyping, design engineering, and design-to-development support from Krakow, Poland for startups, SaaS, fintech, crypto, Web3, mobile app, and web app teams.',
                url: siteUrl + '/',
                image: metaImage,
                founder: { '@id': siteUrl + '/#person' },
                areaServed: [
                    { '@type': 'Country', name: 'Poland' },
                    { '@type': 'City', name: 'Krakow' },
                    { '@type': 'City', name: 'Kraków' },
                    { '@type': 'AdministrativeArea', name: 'Europe' },
                    { '@type': 'Place', name: 'Remote worldwide' }
                ],
                serviceType: [
                    'Product design',
                    'Startup product design',
                    'Product design partner for startups',
                    'AI-assisted product design',
                    'AI prototyping',
                    'Design engineering',
                    'Design-to-code workflows',
                    'UI/UX design',
                    'Design systems',
                    'Mobile app design',
                    'Web app design',
                    'SaaS product design',
                    'Fintech product design',
                    'Crypto and Web3 UX design',
                    'Figma prototyping',
                    'Design-to-development handoff'
                ],
                knowsAbout: [
                    'Digital products',
                    'Interface design',
                    'Design tokens',
                    'Responsive web apps',
                    'Landing pages',
                    'UX audits',
                    'AI-assisted prototyping',
                    'Design engineering'
                ]
            });
        }
        jsonLdGraph.push({
            '@type': 'WebPage',
            '@id': canonicalUrl + '#webpage',
            url: canonicalUrl,
            name: metaTitle,
            description: metaDescription,
            inLanguage: config.language || 'en',
            isPartOf: { '@id': siteUrl + '/#website' },
            about: { '@id': siteUrl + '/#person' },
            ...(page.layout === 'project' ? { mainEntity: { '@id': canonicalUrl + '#project' } } : {})
        });
        if (page.layout === 'project') jsonLdGraph.push({
            '@type': 'CreativeWork',
            '@id': canonicalUrl + '#project',
            name: page.title,
            description: metaDescription,
            url: canonicalUrl,
            image: metaImage,
            creator: { '@id': siteUrl + '/#person' },
            mainEntityOfPage: { '@id': canonicalUrl + '#webpage' },
            ...(page.website ? { about: { '@type': 'WebSite', name: page.title, url: page.website } } : {})
        });
        const structuredData = {
            '@context': 'https://schema.org',
            '@graph': jsonLdGraph
        };
    %>
    <script>
        // Reinitialize all media when the OS preference changes. beforeunload
        // preserves the selected panel and scroll position in main.js.
        const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
        window.folioReducedMotion = motionPreference.matches;
        motionPreference.addEventListener('change', () => window.location.reload());
        // Initialize theme BEFORE any content renders to prevent flash
        (function () {
            const storedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();

    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <title>
        <%= metaTitle %>
    </title>
    <meta name="description" content="<%= metaDescription %>">
    <meta name="keywords" content="<%= metaKeywords %>">
    <meta name="author" content="<%= config.author %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="sitemap" type="application/xml" href="<%= siteUrl %>/sitemap.xml">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Michal Sambora">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:title" content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:image" content="<%= metaImage %>">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@samborekpk">
    <meta name="twitter:url" content="<%= canonicalUrl %>">
    <meta name="twitter:title" content="<%= metaTitle %>">
    <meta name="twitter:description" content="<%= metaDescription %>">
    <meta name="twitter:image" content="<%= metaImage %>">
    <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Preload skeleton thumbnail -->
    <link rel="preload" href="/images/work/hydrationblur.jpg" as="image">

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">

    <!-- Styles -->
    <%- css('css/style') %>
    <%- css('css/reduced-motion') %>
    <noscript><%- css('css/no-js') %></noscript>

        <!-- Vercel Analytics -->
        <script defer src="/_vercel/insights/script.js"></script>
</head>

<body class="<%= page.layout %>-page">
    <div id="page-cover"
        style="display:none;opacity:0;position:fixed;inset:0;background:var(--color-bg);z-index:99999;pointer-events:none;transition:opacity 0.2s ease-out;">
    </div>
    <main class="main-content">
        <%- body %>
    </main>

    <% if (!is_home()) { %>
        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-cta">
                    <h2>Let's make something<br>great together</h2>
                    <a href="mailto:<%= theme.email || theme.connect?.email || 'contact@msambora.com' %>" class="footer-email copy-email-btn">
                        <%= theme.email || theme.connect?.email || 'contact@msambora.com' %>
                    </a>
                </div>
                <div class="footer-bottom">
                    <span class="copyright">&copy; <%= new Date().getFullYear() %>
                            <%= config.author %></span>
                    <ul class="social-links">
                        <% if (theme.social?.twitter) { %>
                            <li><a href="<%= theme.social.twitter %>" target="_blank">Twitter</a></li>
                            <% } %>
                                <% if (theme.social?.linkedin) { %>
                                    <li><a href="<%= theme.social.linkedin %>" target="_blank">LinkedIn</a></li>
                                    <% } %>
                                        <% if (theme.social?.dribbble) { %>
                                            <li><a href="<%= theme.social.dribbble %>" target="_blank">Dribbble</a></li>
                                            <% } %>
                                                <% if (theme.social?.behance) { %>
                                                    <li><a href="<%= theme.social.behance %>"
                                                            target="_blank">Behance</a></li>
                                                    <% } %>
                    </ul>
                </div>
            </div>
        </footer>
        <% } %>



            <!-- Lenis smooth scroll -->
            <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

            <!-- Unicorn Studio SDK -->
            <script src="/js/unicorn/unicornStudio.umd.js"></script>
            <%- js('js/embla-carousel') %>
                <%- js('js/main') %>
</body>


</html>
