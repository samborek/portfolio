<!DOCTYPE html>
<html lang="<%= config.language %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= page.title ? page.title + ' | ' + config.title : config.title %>
    </title>
    <meta name="description" content="<%= page.description || config.description %>">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Preload skeleton thumbnail -->
    <link rel="preload" href="/images/work/hydrationblur.jpg" as="image">

    <!-- Styles -->
    <%- css('css/style') %>

        <!-- Unicorn Studio SDK -->
        <script src="/js/unicorn/unicornStudio.umd.js"></script>
        <script src="/js/unicorn/model-renderer.js"></script>
</head>

<body class="<%= page.layout %>-page">
    <main class="main-content">
        <%- body %>
    </main>

    <% if (!is_home()) { %>
        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-cta">
                    <h2>Let's make something<br>great together</h2>
                    <a href="mailto:<%= theme.email || 'hello@example.com' %>" class="footer-email">
                        <%= theme.email || 'hello@example.com' %>
                    </a>
                </div>
                <div class="footer-bottom">
                    <span class="copyright">&copy; <%= new Date().getFullYear() %>
                            <%= config.author %></span>
                    <ul class="social-links">
                        <% if (theme.social && theme.social.twitter) { %>
                            <li><a href="<%= theme.social.twitter %>" target="_blank">Twitter</a></li>
                            <% } %>
                                <% if (theme.social && theme.social.linkedin) { %>
                                    <li><a href="<%= theme.social.linkedin %>" target="_blank">LinkedIn</a></li>
                                    <% } %>
                                        <% if (theme.social && theme.social.dribbble) { %>
                                            <li><a href="<%= theme.social.dribbble %>" target="_blank">Dribbble</a></li>
                                            <% } %>
                                                <% if (theme.social && theme.social.github) { %>
                                                    <li><a href="<%= theme.social.github %>" target="_blank">GitHub</a>
                                                    </li>
                                                    <% } %>
                    </ul>
                </div>
            </div>
        </footer>
        <% } %>

            <%- js('js/main') %>
                <%- js('js/embla-carousel') %>
                    <script>
                        // Initialize Embla Carousel for all project carousels
                        document.addEventListener('DOMContentLoaded', () => {
                            const emblaNodes = document.querySelectorAll('.embla');

                            emblaNodes.forEach((emblaNode) => {
                                const viewportNode = emblaNode.querySelector('.embla__viewport');
                                const wrapper = emblaNode.closest('.project-carousel-wrapper');
                                const section = emblaNode.closest('.project-section');
                                const progressBar = section?.querySelector('.project-carousel-progress span');
                                const navZones = wrapper?.querySelectorAll('.carousel-nav-zone');

                                if (!viewportNode) return;

                                const embla = EmblaCarousel(viewportNode, {
                                    loop: false,
                                    align: 'start',
                                    dragFree: false,
                                    containScroll: 'trimSnaps'
                                });

                                // Update progress bar - segmented by number of slides
                                let lastProgress = 0;

                                const updateProgress = () => {
                                    if (!progressBar) return;
                                    const totalSlides = embla.slideNodes().length;
                                    if (totalSlides === 0) return;

                                    const scrollSnaps = embla.scrollSnapList();
                                    const currentIndex = embla.selectedScrollSnap();
                                    const scrollProgress = embla.scrollProgress();

                                    if (scrollSnaps.length === 0) {
                                        progressBar.style.transform = `scaleX(${Math.max(0, Math.min(1, (currentIndex + 1) / totalSlides))})`;
                                        return;
                                    }

                                    const segmentStart = scrollSnaps[currentIndex] ?? 0;
                                    const segmentEnd = scrollSnaps[currentIndex + 1] ?? 1;
                                    const segmentRange = Math.max(segmentEnd - segmentStart, Number.EPSILON);
                                    const segmentProgress = Math.min(Math.max((scrollProgress - segmentStart) / segmentRange, 0), 1);

                                    let progress = ((currentIndex + segmentProgress) / totalSlides) + (1 / totalSlides);
                                    progress = Math.max(progress, 1 / totalSlides);
                                    progress = Math.min(progress, 1);

                                    const isGoingForward = progress > lastProgress;
                                    const duration = isGoingForward ? 0.4 : 0.15;
                                    progressBar.style.setProperty('--progress-transition', `${duration}s`);
                                    lastProgress = progress;

                                    progressBar.style.transform = `scaleX(${progress})`;
                                };

                                embla.on('scroll', updateProgress);
                                embla.on('init', updateProgress);
                                updateProgress();

                                // Click navigation - detect left/right based on click position
                                if (wrapper) {
                                    let isDragging = false;
                                    let startX = 0;

                                    wrapper.addEventListener('pointerdown', (e) => {
                                        startX = e.clientX;
                                        isDragging = false;
                                    });

                                    wrapper.addEventListener('pointermove', (e) => {
                                        if (Math.abs(e.clientX - startX) > 5) {
                                            isDragging = true;
                                        }
                                    });

                                    wrapper.addEventListener('click', (e) => {
                                        // Only handle click if not dragging
                                        if (isDragging) return;

                                        const rect = wrapper.getBoundingClientRect();
                                        const clickX = e.clientX - rect.left;
                                        const isLeftHalf = clickX < rect.width / 2;

                                        if (isLeftHalf) {
                                            embla.scrollPrev();
                                        } else {
                                            embla.scrollNext();
                                        }
                                    });

                                    // Set cursor based on hover position
                                    wrapper.addEventListener('mousemove', (e) => {
                                        const rect = wrapper.getBoundingClientRect();
                                        const x = e.clientX - rect.left;
                                        wrapper.style.cursor = x < rect.width / 2 ? 'w-resize' : 'e-resize';
                                    });

                                    // Wheel event for touchpad horizontal scroll
                                    let wheelAccumulator = 0;
                                    const wheelThreshold = 100;
                                    let wheelCooldown = false;

                                    wrapper.addEventListener('wheel', (e) => {
                                        // Detect horizontal scroll (deltaX) or shift+vertical
                                        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : 0;

                                        if (delta !== 0) {
                                            e.preventDefault();

                                            if (wheelCooldown) return;

                                            wheelAccumulator += delta;

                                            if (Math.abs(wheelAccumulator) > wheelThreshold) {
                                                if (wheelAccumulator > 0) {
                                                    embla.scrollNext();
                                                } else {
                                                    embla.scrollPrev();
                                                }
                                                wheelAccumulator = 0;

                                                // Cooldown to scroll only 1 image at a time
                                                wheelCooldown = true;
                                                setTimeout(() => { wheelCooldown = false; }, 800);
                                            }
                                        }
                                    }, { passive: false });
                                }
                            });
                        });
                    </script>

                    <script>
                        // Initialize Unicorn Studio for avatar
                        document.addEventListener('DOMContentLoaded', () => {
                            if (window.UnicornStudio) {
                                // Initialize all scenes except the button (which needs special handling)
                                UnicornStudio.init().then(() => {
                                    console.log('Unicorn Studio initialized');

                                    // Workaround for mouse-tracking scenes that break after scrolling out of view
                                    // Find the button scene and set up visibility observer to refresh mouse tracking
                                    const buttonEl = document.querySelector('.unicorn-btn');
                                    if (buttonEl) {
                                        const buttonCanvas = buttonEl.querySelector('canvas');

                                        // Create observer to detect when button comes back into view
                                        const visibilityObserver = new IntersectionObserver((entries) => {
                                            entries.forEach(entry => {
                                                if (entry.isIntersecting && buttonCanvas) {
                                                    // Dispatch a synthetic mousemove to re-sync mouse position
                                                    // This triggers the SDK to update its internal mouse state
                                                    const rect = buttonEl.getBoundingClientRect();
                                                    const centerX = rect.left + rect.width / 2;
                                                    const centerY = rect.top + rect.height / 2;

                                                    buttonEl.dispatchEvent(new MouseEvent('mousemove', {
                                                        clientX: centerX,
                                                        clientY: centerY,
                                                        bubbles: true
                                                    }));
                                                }
                                            });
                                        }, { threshold: 0.1 });

                                        visibilityObserver.observe(buttonEl);
                                    }
                                }).catch(err => console.error(err));
                            }

                            // ScrollSpy for sidebar navigation
                            const sections = document.querySelectorAll('section[id^="project-"], #experience, #clients, #connect');
                            const navLinks = document.querySelectorAll('.project-link-item');

                            const observerOptions = {
                                root: null,
                                // Check intersection with a line at 40% from top of screen to capture section titles early
                                rootMargin: '-40% 0px -60% 0px',
                                threshold: 0
                            };

                            const observer = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    if (entry.isIntersecting) {
                                        // Remove active class from all links
                                        navLinks.forEach(link => link.classList.remove('active'));

                                        // Add active class to corresponding link
                                        const id = entry.target.getAttribute('id');
                                        const activeLink = document.querySelector(`.project-link-item[href="#${id}"]`);
                                        if (activeLink) {
                                            activeLink.classList.add('active');
                                        }
                                    }
                                });
                            }, observerOptions);

                            sections.forEach(section => observer.observe(section));

                            // Work section toggle
                            const workToggle = document.querySelector('.project-links-toggle');
                            const workList = document.getElementById('work-list');

                            if (workToggle && workList) {
                                workToggle.addEventListener('click', () => {
                                    const isExpanded = workToggle.getAttribute('aria-expanded') === 'true';
                                    workToggle.setAttribute('aria-expanded', !isExpanded);
                                    workList.classList.toggle('collapsed', isExpanded);
                                });
                            }
                        });
                    </script>
</body>

</html>