<!DOCTYPE html>
<html lang="<%= config.language %>">

<head>
    <script>
        // Immediately add loading class to prevent flash of unstyled font
        document.documentElement.classList.add('fonts-loading');
        // Fallback to show content if fonts take too long or fail
        const fontTimeout = setTimeout(() => {
            document.documentElement.classList.remove('fonts-loading');
        }, 1000);

        document.fonts.ready.then(() => {
            clearTimeout(fontTimeout);
            document.documentElement.classList.remove('fonts-loading');
        });
    </script>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover">
    <title>
        <%= page.title ? page.title + ' | ' + config.title : config.title %>
    </title>
    <meta name="description" content="<%= page.description || config.description %>">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="/font/GazpachoRegular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/font/GazpachoBold.woff2" as="font" type="font/woff2" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Preload skeleton thumbnail -->
    <link rel="preload" href="/images/work/hydrationblur.jpg" as="image">

    <!-- Styles -->
    <%- css('css/style') %>

        <!-- Unicorn Studio SDK -->
        <script src="/js/unicorn/unicornStudio.umd.js"></script>
        <script src="/js/unicorn/model-renderer.js"></script>
</head>

<body class="<%= page.layout %>-page">
    <main class="main-content">
        <%- body %>
    </main>

    <% if (!is_home()) { %>
        <footer class="site-footer">
            <div class="footer-content">
                <div class="footer-cta">
                    <h2>Let's make something<br>great together</h2>
                    <a href="mailto:<%= theme.email || 'hello@example.com' %>" class="footer-email">
                        <%= theme.email || 'hello@example.com' %>
                    </a>
                </div>
                <div class="footer-bottom">
                    <span class="copyright">&copy; <%= new Date().getFullYear() %>
                            <%= config.author %></span>
                    <ul class="social-links">
                        <% if (theme.social?.twitter) { %>
                            <li><a href="<%= theme.social.twitter %>" target="_blank">Twitter</a></li>
                            <% } %>
                                <% if (theme.social?.linkedin) { %>
                                    <li><a href="<%= theme.social.linkedin %>" target="_blank">LinkedIn</a></li>
                                    <% } %>
                                        <% if (theme.social?.dribbble) { %>
                                            <li><a href="<%= theme.social.dribbble %>" target="_blank">Dribbble</a></li>
                                            <% } %>
                                                <% if (theme.social?.behance) { %>
                                                    <li><a href="<%= theme.social.behance %>"
                                                            target="_blank">Behance</a></li>
                                                    <% } %>
                                                        <% if (theme.social?.gumroad) { %>
                                                            <li><a href="<%= theme.social.gumroad %>"
                                                                    target="_blank">Gumroad</a></li>
                                                            <% } %>
                    </ul>
                </div>
            </div>
        </footer>
        <% } %>


            <%- js('js/embla-carousel') %>
                <%- js('js/main') %>
</body>

</html>