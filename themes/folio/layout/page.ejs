<article class="page">
    <nav class="page-nav">
        <a class="project-back" href="<%- url_for('/') %>">
            <span class="project-back-icon" aria-hidden="true">&larr;</span>
            <span class="project-back-label">Back</span>
        </a>
    </nav>
    <header class="page-header">
        <h1 class="page-title">
            <%= page.title %>
        </h1>
        <% if (page.subtitle) { %>
            <p class="page-subtitle">
                <%= page.subtitle %>
            </p>
            <% } %>
    </header>

    <div class="page-content">
        <%- page.content %>
    </div>
</article>